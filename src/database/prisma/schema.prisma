// Shop — database schema.
//
// Conventions (PLAN.md §3.1):
//   - every table: `id UUID` primary key generated by Postgres, constraint `pk_<table>`
//   - every relationship: real UUID FK column, constraint `fk_<table>_<column>`,
//     explicit ON DELETE / ON UPDATE, and an index whose leading column is the FK
//   - constraint/index names are pinned with `map:` so migrations, the migration
//     verification test and error mapping all refer to the same names.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

/// Back-office users (staff). Customers live in their own table (Phase 5).
model AdminUser {
  id                String          @id(map: "pk_admin_users") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String          @unique(map: "uq_admin_users_email") @db.Citext
  passwordHash      String          @map("password_hash")
  firstName         String?         @map("first_name") @db.VarChar(100)
  lastName          String?         @map("last_name") @db.VarChar(100)
  status            AdminUserStatus @default(ACTIVE)
  failedLogins      Int             @default(0) @map("failed_logins")
  lockedUntil       DateTime?       @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?       @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime        @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  roles             AdminUserRole[]
  refreshTokens     RefreshToken[]
  apiKeys           ApiKey[]
  images            Image[]
  pages             Page[]
  posts             Post[]
  schedules         Schedule[]
  refunds           Refund[]
  jobs              Job[]
  webhooks          Webhook[]

  @@index([deletedAt], map: "ix_admin_users_deleted_at")
  @@map("admin_users")
}

model Role {
  id          String           @id(map: "pk_roles") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique(map: "uq_roles_code") @db.VarChar(64)
  name        String           @db.VarChar(100)
  description String?
  /// System roles (e.g. super-admin) cannot be deleted or renamed.
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       AdminUserRole[]

  @@map("roles")
}

/// A permission string from the code catalogue (`catalog:write`, `*`), granted to a role.
model RolePermission {
  id         String   @id(map: "pk_role_permissions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_role_permissions_role_id")
  permission String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([roleId, permission], map: "uq_role_permissions_role_id_permission")
  @@map("role_permissions")
}

model AdminUserRole {
  id          String    @id(map: "pk_admin_user_roles") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_admin_user_roles_admin_user_id")
  roleId      String    @map("role_id") @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_admin_user_roles_role_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([adminUserId, roleId], map: "uq_admin_user_roles_admin_user_id_role_id")
  @@index([roleId], map: "ix_admin_user_roles_role_id")
  @@map("admin_user_roles")
}

/// Rotating refresh tokens. Only a SHA-256 of the token is stored. Tokens of one login share a
/// `family_id`; reusing a rotated token revokes the whole family (theft detection).
model RefreshToken {
  id           String         @id(map: "pk_refresh_tokens") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId  String         @map("admin_user_id") @db.Uuid
  adminUser    AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_refresh_tokens_admin_user_id")
  familyId     String         @map("family_id") @db.Uuid
  tokenHash    String         @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash") @db.Char(64)
  replacedById String?        @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_refresh_tokens_replaced_by_id")
  replaces     RefreshToken[] @relation("RefreshTokenRotation")
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(3)
  userAgent    String?        @map("user_agent") @db.VarChar(255)
  ip           String?        @db.VarChar(64)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([adminUserId], map: "ix_refresh_tokens_admin_user_id")
  @@index([familyId], map: "ix_refresh_tokens_family_id")
  @@index([replacedById], map: "ix_refresh_tokens_replaced_by_id")
  @@index([expiresAt], map: "ix_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

/// Integration keys. `prefix` (first chars, shown in the UI) finds the row; the full key is
/// verified against `key_hash` (SHA-256) in constant time. Permissions are a subset of the catalogue.
model ApiKey {
  id          String     @id(map: "pk_api_keys") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(100)
  prefix      String     @unique(map: "uq_api_keys_prefix") @db.VarChar(16)
  keyHash     String     @unique(map: "uq_api_keys_key_hash") @map("key_hash") @db.Char(64)
  permissions String[]
  createdById String?    @map("created_by_id") @db.Uuid
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_api_keys_created_by_id")
  expiresAt   DateTime?  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt  DateTime?  @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdById], map: "ix_api_keys_created_by_id")
  @@map("api_keys")
}

/// Who changed what. Written from after-events; no FKs so history outlives the rows it describes.
model AuditLog {
  id         String   @id(map: "pk_audit_logs") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType  String   @map("actor_type") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.Uuid
  actorLabel String   @map("actor_label") @db.VarChar(255)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  changes    Json?
  requestId  String?  @map("request_id") @db.VarChar(64)
  ip         String?  @db.VarChar(64)
  /// The after-event this row records (outbox id): a redelivered event is logged once.
  eventId    String?  @unique(map: "uq_audit_logs_event_id") @map("event_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "ix_audit_logs_entity_type_entity_id_created_at")
  @@index([actorId, createdAt(sort: Desc)], map: "ix_audit_logs_actor_id_created_at")
  @@index([createdAt], map: "ix_audit_logs_created_at")
  @@map("audit_logs")
}

/// Transactional outbox: after-commit events written in the producing transaction (PLAN.md §4).
model OutboxEvent {
  id          String    @id(map: "pk_outbox_events") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName   String    @map("event_name") @db.VarChar(120)
  payload     Json
  origin      String    @db.VarChar(16)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([origin, availableAt], map: "ix_outbox_events_origin_available_at")
  @@index([failedAt], map: "ix_outbox_events_failed_at")
  @@map("outbox_events")
}

// ───────────────────────────── Phase 1 — websites, stores, locales, currencies ─────────────────────────────

/// BCP 47 locale (`en-US`, `vi-VN`). Referenced by code; `fallback_code` forms the translation fallback chain.
model Locale {
  id                String                          @id(map: "pk_locales") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                          @unique(map: "uq_locales_code") @db.VarChar(16)
  name              String                          @db.VarChar(100)
  isActive          Boolean                         @default(false) @map("is_active")
  fallbackCode      String?                         @map("fallback_code") @db.VarChar(16)
  fallback          Locale?                         @relation("LocaleFallback", fields: [fallbackCode], references: [code], onDelete: SetNull, onUpdate: Cascade, map: "fk_locales_fallback_code")
  fallbackOf        Locale[]                        @relation("LocaleFallback")
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  storesDefault     Store[]
  storeLocales      StoreLocale[]
  categoryTrans     CategoryTranslation[]
  productTrans      ProductTranslation[]
  attributeTrans    AttributeTranslation[]
  optionTrans       AttributeOptionTranslation[]
  bundleOptionTrans BundleOptionTranslation[]
  imageTrans        ImageTranslation[]
  urlRewrites       UrlRewrite[]
  searchDocuments   SearchDocument[]
  pageTrans         PageTranslation[]
  customers         Customer[]
  promotionTrans    PromotionTranslation[]
  shippingTrans     ShippingMethodTranslation[]
  paymentTrans      StorePaymentMethodTranslation[]
  postTrans         PostTranslation[]
  tagTrans          TagTranslation[]
  blockTrans        BlockTranslation[]
  menuItemTrans     MenuItemTranslation[]
  bannerTrans       BannerTranslation[]
  slideTrans        SlideTranslation[]

  @@index([fallbackCode], map: "ix_locales_fallback_code")
  @@map("locales")
}

/// ISO 4217 currency. Money is always integer minor units (`minor_units` digits) + currency code.
model Currency {
  id              String           @id(map: "pk_currencies") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique(map: "uq_currencies_code") @db.Char(3)
  name            String           @db.VarChar(100)
  symbol          String           @db.VarChar(8)
  minorUnits      Int              @map("minor_units") @db.SmallInt
  isActive        Boolean          @default(false) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  websites        Website[]
  storesDefault   Store[]
  storeCurrencies StoreCurrency[]
  priceBooks      PriceBook[]
  priceIndex      PriceIndex[]
  ratesFrom       ExchangeRate[]   @relation("RateBase")
  ratesTo         ExchangeRate[]   @relation("RateQuote")
  campaignBudgets Campaign[]
  loyaltyPrograms LoyaltyProgram[]
  orders          Order[]

  @@map("currencies")
}

/// Magento "website": groups stores; products and categories are assigned per website.
model Website {
  id               String                   @id(map: "pk_websites") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String                   @unique(map: "uq_websites_code") @db.VarChar(64)
  name             String                   @db.VarChar(255)
  baseCurrencyCode String                   @map("base_currency_code") @db.Char(3)
  baseCurrency     Currency                 @relation(fields: [baseCurrencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_websites_base_currency_code")
  defaultStoreId   String?                  @map("default_store_id") @db.Uuid
  defaultStore     Store?                   @relation("WebsiteDefaultStore", fields: [defaultStoreId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_websites_default_store_id")
  position         Int                      @default(0)
  isActive         Boolean                  @default(true) @map("is_active")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  stores           Store[]                  @relation("WebsiteStores")
  products         ProductWebsite[]
  categories       CategoryWebsite[]
  priceBooks       PriceBook[]
  inventorySources WebsiteInventorySource[]
  searchSettings   SearchSettings?
  customers        Customer[]
  promotions       PromotionWebsite[]
  loyaltyProgram   LoyaltyProgram?
  shippingMethods  ShippingMethod[]
  orders           Order[]

  @@index([baseCurrencyCode], map: "ix_websites_base_currency_code")
  @@index([defaultStoreId], map: "ix_websites_default_store_id")
  @@map("websites")
}

/// Magento "store view": one storefront with its locales, currencies, country and tax display.
model Store {
  id                  String                 @id(map: "pk_stores") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId           String                 @map("website_id") @db.Uuid
  website             Website                @relation("WebsiteStores", fields: [websiteId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_stores_website_id")
  code                String                 @unique(map: "uq_stores_code") @db.VarChar(64)
  name                String                 @db.VarChar(255)
  /// Public origin, e.g. https://shop.example.vn — also resolves the store from the request Host.
  baseUrl             String?                @unique(map: "uq_stores_base_url") @map("base_url") @db.VarChar(255)
  defaultLocaleCode   String                 @map("default_locale_code") @db.VarChar(16)
  defaultLocale       Locale                 @relation(fields: [defaultLocaleCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_stores_default_locale_code")
  defaultCurrencyCode String                 @map("default_currency_code") @db.Char(3)
  defaultCurrency     Currency               @relation(fields: [defaultCurrencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_stores_default_currency_code")
  countryCode         String                 @map("country_code") @db.Char(2)
  pricesIncludeTax    Boolean                @default(false) @map("prices_include_tax")
  position            Int                    @default(0)
  isActive            Boolean                @default(true) @map("is_active")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  defaultOfWebsites   Website[]              @relation("WebsiteDefaultStore")
  locales             StoreLocale[]
  currencies          StoreCurrency[]
  productOverrides    ProductStoreOverride[]
  urlRewrites         UrlRewrite[]
  priceBooks          PriceBook[]
  priceIndex          PriceIndex[]
  searchDocuments     SearchDocument[]
  pages               Page[]
  posts               Post[]
  carts               Cart[]
  orders              Order[]
  paymentMethods      StorePaymentMethod[]
  blocks              Block[]
  menus               Menu[]
  banners             Banner[]
  sliders             Slider[]

  @@index([websiteId], map: "ix_stores_website_id")
  @@index([defaultLocaleCode], map: "ix_stores_default_locale_code")
  @@index([defaultCurrencyCode], map: "ix_stores_default_currency_code")
  @@map("stores")
}

model StoreLocale {
  id         String   @id(map: "pk_store_locales") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_store_locales_store_id")
  localeCode String   @map("locale_code") @db.VarChar(16)
  locale     Locale   @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_store_locales_locale_code")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([storeId, localeCode], map: "uq_store_locales_store_id_locale_code")
  @@index([localeCode], map: "ix_store_locales_locale_code")
  @@map("store_locales")
}

model StoreCurrency {
  id           String   @id(map: "pk_store_currencies") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_store_currencies_store_id")
  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_store_currencies_currency_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([storeId, currencyCode], map: "uq_store_currencies_store_id_currency_code")
  @@index([currencyCode], map: "ix_store_currencies_currency_code")
  @@map("store_currencies")
}

// ───────────────────────────── Phase 1 — attributes ─────────────────────────────

enum AttributeType {
  TEXT
  TEXTAREA
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  SELECT
  MULTISELECT
}

/// Typed attribute definition. Values live in `products.attributes` (JSONB, keyed by code) or, when
/// `is_localizable`, in `product_translations.attributes`.
model Attribute {
  id             String                  @id(map: "pk_attributes") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String                  @unique(map: "uq_attributes_code") @db.VarChar(64)
  type           AttributeType
  isRequired     Boolean                 @default(false) @map("is_required")
  isFilterable   Boolean                 @default(false) @map("is_filterable")
  isSearchable   Boolean                 @default(false) @map("is_searchable")
  isLocalizable  Boolean                 @default(false) @map("is_localizable")
  /// Shown on the storefront product page.
  isVisible      Boolean                 @default(true) @map("is_visible")
  position       Int                     @default(0)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations   AttributeTranslation[]
  options        AttributeOption[]
  sets           AttributeSetAttribute[]
  configurableOf ConfigurableAttribute[]

  @@map("attributes")
}

model AttributeTranslation {
  id          String    @id(map: "pk_attribute_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_attribute_translations_attribute_id")
  localeCode  String    @map("locale_code") @db.VarChar(16)
  locale      Locale    @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_attribute_translations_locale_code")
  label       String    @db.VarChar(255)

  @@unique([attributeId, localeCode], map: "uq_attribute_translations_attribute_id_locale_code")
  @@index([localeCode], map: "ix_attribute_translations_locale_code")
  @@map("attribute_translations")
}

model AttributeOption {
  id           String                       @id(map: "pk_attribute_options") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeId  String                       @map("attribute_id") @db.Uuid
  attribute    Attribute                    @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_attribute_options_attribute_id")
  code         String                       @db.VarChar(64)
  /// Colour hex or image hint for swatches.
  swatch       String?                      @db.VarChar(64)
  position     Int                          @default(0)
  translations AttributeOptionTranslation[]

  @@unique([attributeId, code], map: "uq_attribute_options_attribute_id_code")
  @@map("attribute_options")
}

model AttributeOptionTranslation {
  id         String          @id(map: "pk_attribute_option_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId   String          @map("option_id") @db.Uuid
  option     AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_attribute_option_translations_option_id")
  localeCode String          @map("locale_code") @db.VarChar(16)
  locale     Locale          @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_attribute_option_translations_locale_code")
  label      String          @db.VarChar(255)

  @@unique([optionId, localeCode], map: "uq_attribute_option_translations_option_id_locale_code")
  @@index([localeCode], map: "ix_attribute_option_translations_locale_code")
  @@map("attribute_option_translations")
}

/// Which attributes a kind of product has (apparel: colour, size, material…).
model AttributeSet {
  id         String                  @id(map: "pk_attribute_sets") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String                  @unique(map: "uq_attribute_sets_code") @db.VarChar(64)
  name       String                  @db.VarChar(255)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  attributes AttributeSetAttribute[]
  products   Product[]

  @@map("attribute_sets")
}

model AttributeSetAttribute {
  id             String       @id(map: "pk_attribute_set_attributes") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeSetId String       @map("attribute_set_id") @db.Uuid
  attributeSet   AttributeSet @relation(fields: [attributeSetId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_attribute_set_attributes_attribute_set_id")
  attributeId    String       @map("attribute_id") @db.Uuid
  attribute      Attribute    @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_attribute_set_attributes_attribute_id")
  groupName      String       @default("General") @map("group_name") @db.VarChar(64)
  position       Int          @default(0)

  @@unique([attributeSetId, attributeId], map: "uq_attribute_set_attributes_attribute_set_id_attribute_id")
  @@index([attributeId], map: "ix_attribute_set_attributes_attribute_id")
  @@map("attribute_set_attributes")
}

// ───────────────────────────── Phase 1 — categories ─────────────────────────────

/// Category tree. `path` is the materialised chain of ids (`<root>/<child>/<id>`) for subtree queries
/// (`path LIKE '<path>/%'`; category tables stay small, so no pattern-ops index — Prisma can't model one).
model Category {
  id            String                @id(map: "pk_categories") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId      String?               @map("parent_id") @db.Uuid
  parent        Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_categories_parent_id")
  children      Category[]            @relation("CategoryTree")
  path          String
  level         Int                   @default(0) @db.SmallInt
  position      Int                   @default(0)
  isActive      Boolean               @default(true) @map("is_active")
  includeInMenu Boolean               @default(true) @map("include_in_menu")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations  CategoryTranslation[]
  websites      CategoryWebsite[]
  products      ProductCategory[]

  @@index([parentId, position], map: "ix_categories_parent_id_position")
  @@map("categories")
}

model CategoryTranslation {
  id              String   @id(map: "pk_category_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_category_translations_category_id")
  localeCode      String   @map("locale_code") @db.VarChar(16)
  locale          Locale   @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_category_translations_locale_code")
  name            String   @db.VarChar(255)
  slug            String   @db.VarChar(255)
  description     String?
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.VarChar(512)

  @@unique([categoryId, localeCode], map: "uq_category_translations_category_id_locale_code")
  @@index([localeCode], map: "ix_category_translations_locale_code")
  @@map("category_translations")
}

model CategoryWebsite {
  id         String   @id(map: "pk_category_websites") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_category_websites_category_id")
  websiteId  String   @map("website_id") @db.Uuid
  website    Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_category_websites_website_id")

  @@unique([categoryId, websiteId], map: "uq_category_websites_category_id_website_id")
  @@index([websiteId], map: "ix_category_websites_website_id")
  @@map("category_websites")
}

// ───────────────────────────── Phase 1 — products ─────────────────────────────

enum ProductType {
  SIMPLE
  CONFIGURABLE
  BUNDLE
  VIRTUAL
  GIFT_CARD
}

enum ProductStatus {
  ENABLED
  DISABLED
}

enum ProductVisibility {
  CATALOG_SEARCH
  CATALOG
  SEARCH
  NOT_VISIBLE
}

enum ProductRelationType {
  RELATED
  UPSELL
  CROSSSELL
}

enum BundleInputType {
  SELECT
  RADIO
  CHECKBOX
  MULTI
}

/// One global catalog row per product. Sellable units are `product_variants` (every non-configurable
/// product has exactly one default variant), so prices and stock always key on a variant.
model Product {
  id                     String                  @id(map: "pk_products") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                    String                  @unique(map: "uq_products_sku") @db.VarChar(64)
  type                   ProductType
  status                 ProductStatus           @default(ENABLED)
  visibility             ProductVisibility       @default(CATALOG_SEARCH)
  attributeSetId         String                  @map("attribute_set_id") @db.Uuid
  attributeSet           AttributeSet            @relation(fields: [attributeSetId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_products_attribute_set_id")
  /// Non-localizable attribute values keyed by attribute code (validated against the definitions).
  attributes             Json                    @default("{}")
  /// Type-specific settings: bundle `priceType`, gift card amounts…
  typeOptions            Json                    @default("{}") @map("type_options")
  weightGrams            Int?                    @map("weight_grams")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  translations           ProductTranslation[]
  websites               ProductWebsite[]
  storeOverrides         ProductStoreOverride[]
  variants               ProductVariant[]
  configurableAttributes ConfigurableAttribute[]
  categories             ProductCategory[]
  relations              ProductRelation[]       @relation("ProductRelations")
  relatedTo              ProductRelation[]       @relation("ProductRelatedTo")
  bundleOptions          BundleOption[]
  orderItems             OrderItem[]
  /// NULL = the `standard` product tax class.
  taxClassId             String?                 @map("tax_class_id") @db.Uuid
  taxClass               TaxClass?               @relation(fields: [taxClassId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_products_tax_class_id")

  @@index([attributeSetId], map: "ix_products_attribute_set_id")
  @@index([taxClassId], map: "ix_products_tax_class_id")
  @@index([type], map: "ix_products_type")
  @@index([deletedAt], map: "ix_products_deleted_at")
  @@index([attributes(ops: JsonbPathOps)], type: Gin, map: "ix_products_attributes")
  @@map("products")
}

model ProductTranslation {
  id               String  @id(map: "pk_product_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_translations_product_id")
  localeCode       String  @map("locale_code") @db.VarChar(16)
  locale           Locale  @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_product_translations_locale_code")
  name             String  @db.VarChar(255)
  slug             String  @db.VarChar(255)
  shortDescription String? @map("short_description")
  description      String?
  metaTitle        String? @map("meta_title") @db.VarChar(255)
  metaDescription  String? @map("meta_description") @db.VarChar(512)
  /// Localizable attribute values (`is_localizable` attributes) for this locale.
  attributes       Json    @default("{}")

  @@unique([productId, localeCode], map: "uq_product_translations_product_id_locale_code")
  @@unique([localeCode, slug], map: "uq_product_translations_locale_code_slug")
  @@map("product_translations")
}

model ProductWebsite {
  id        String  @id(map: "pk_product_websites") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_websites_product_id")
  websiteId String  @map("website_id") @db.Uuid
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_websites_website_id")

  @@unique([productId, websiteId], map: "uq_product_websites_product_id_website_id")
  @@index([websiteId], map: "ix_product_websites_website_id")
  @@map("product_websites")
}

/// Sparse per-store differences (PLAN.md §3.3): only what differs from the global product.
model ProductStoreOverride {
  id         String             @id(map: "pk_product_store_overrides") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String             @map("product_id") @db.Uuid
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_store_overrides_product_id")
  storeId    String             @map("store_id") @db.Uuid
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_store_overrides_store_id")
  status     ProductStatus?
  visibility ProductVisibility?
  /// Attribute patch merged over `products.attributes` in this store.
  attributes Json               @default("{}")
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([productId, storeId], map: "uq_product_store_overrides_product_id_store_id")
  @@index([storeId], map: "ix_product_store_overrides_store_id")
  @@map("product_store_overrides")
}

/// Sellable unit. Configurable products have one per option combination; other types exactly one default.
model ProductVariant {
  id               String                 @id(map: "pk_product_variants") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String                 @map("product_id") @db.Uuid
  product          Product                @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_variants_product_id")
  sku              String                 @unique(map: "uq_product_variants_sku") @db.VarChar(64)
  /// `{ "color": "red", "size": "m" }` — option codes of the product's configurable attributes.
  optionValues     Json                   @default("{}") @map("option_values")
  /// Canonical `color=red;size=m` (empty for default variants) — one variant per combination.
  optionSignature  String                 @default("") @map("option_signature") @db.VarChar(512)
  isDefault        Boolean                @default(false) @map("is_default")
  status           ProductStatus          @default(ENABLED)
  weightGrams      Int?                   @map("weight_grams")
  position         Int                    @default(0)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  bundleSelections BundleSelection[]
  priceEntries     PriceBookEntry[]
  priceIndex       PriceIndex[]
  stock            Inventory[]
  reservations     InventoryReservation[]
  movements        InventoryMovement[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@unique([productId, optionSignature], map: "uq_product_variants_product_id_option_signature")
  /// At most one default variant per product.
  @@unique([productId], where: raw("is_default"), map: "uq_product_variants_default")
  @@map("product_variants")
}

/// The attributes (colour, size) whose options define a configurable product's variants.
model ConfigurableAttribute {
  id          String    @id(map: "pk_configurable_attributes") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_configurable_attributes_product_id")
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_configurable_attributes_attribute_id")
  position    Int       @default(0)

  @@unique([productId, attributeId], map: "uq_configurable_attributes_product_id_attribute_id")
  @@index([attributeId], map: "ix_configurable_attributes_attribute_id")
  @@map("configurable_attributes")
}

model ProductCategory {
  id         String   @id(map: "pk_product_categories") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_categories_product_id")
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_categories_category_id")
  position   Int      @default(0)

  @@unique([productId, categoryId], map: "uq_product_categories_product_id_category_id")
  @@index([categoryId, position], map: "ix_product_categories_category_id_position")
  @@map("product_categories")
}

model ProductRelation {
  id               String              @id(map: "pk_product_relations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String              @map("product_id") @db.Uuid
  product          Product             @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_relations_product_id")
  relatedProductId String              @map("related_product_id") @db.Uuid
  relatedProduct   Product             @relation("ProductRelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_relations_related_product_id")
  type             ProductRelationType
  position         Int                 @default(0)

  @@unique([productId, relatedProductId, type], map: "uq_product_relations_product_id_related_product_id_type")
  @@index([relatedProductId], map: "ix_product_relations_related_product_id")
  @@map("product_relations")
}

model BundleOption {
  id           String                    @id(map: "pk_bundle_options") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String                    @map("product_id") @db.Uuid
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_bundle_options_product_id")
  code         String                    @db.VarChar(64)
  inputType    BundleInputType           @map("input_type")
  isRequired   Boolean                   @default(true) @map("is_required")
  position     Int                       @default(0)
  translations BundleOptionTranslation[]
  selections   BundleSelection[]

  @@unique([productId, code], map: "uq_bundle_options_product_id_code")
  @@map("bundle_options")
}

model BundleOptionTranslation {
  id         String       @id(map: "pk_bundle_option_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId   String       @map("option_id") @db.Uuid
  option     BundleOption @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_bundle_option_translations_option_id")
  localeCode String       @map("locale_code") @db.VarChar(16)
  locale     Locale       @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_bundle_option_translations_locale_code")
  title      String       @db.VarChar(255)

  @@unique([optionId, localeCode], map: "uq_bundle_option_translations_option_id_locale_code")
  @@index([localeCode], map: "ix_bundle_option_translations_locale_code")
  @@map("bundle_option_translations")
}

model BundleSelection {
  id           String         @id(map: "pk_bundle_selections") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId     String         @map("option_id") @db.Uuid
  option       BundleOption   @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_bundle_selections_option_id")
  /// RESTRICT: a variant sold inside a bundle cannot disappear silently.
  variantId    String         @map("variant_id") @db.Uuid
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_bundle_selections_variant_id")
  qty          Int            @default(1)
  canChangeQty Boolean        @default(false) @map("can_change_qty")
  isDefault    Boolean        @default(false) @map("is_default")
  position     Int            @default(0)

  @@unique([optionId, variantId], map: "uq_bundle_selections_option_id_variant_id")
  @@index([variantId], map: "ix_bundle_selections_variant_id")
  @@map("bundle_selections")
}

// ───────────────────────────── Phase 1 — media & URL rewrites ─────────────────────────────

enum ImageOwnerType {
  PRODUCT
  VARIANT
  CATEGORY
}

enum ImageRole {
  BASE
  SMALL
  THUMBNAIL
  GALLERY
  SWATCH
}

/// Original image in object storage (private bucket); renditions are generated by the media worker.
/// `checksum` (SHA-256) de-duplicates uploads and makes storage keys deterministic.
model Image {
  id               String              @id(map: "pk_images") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey       String              @unique(map: "uq_images_storage_key") @map("storage_key") @db.VarChar(512)
  checksum         String              @unique(map: "uq_images_checksum") @db.Char(64)
  mime             String              @db.VarChar(64)
  width            Int
  height           Int
  bytes            Int
  originalFilename String?             @map("original_filename") @db.VarChar(255)
  /// `{ "200": { key, width, height }, … }` filled in by the media worker.
  renditions       Json                @default("{}")
  createdById      String?             @map("created_by_id") @db.Uuid
  createdBy        AdminUser?          @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_images_created_by_id")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations     ImageTranslation[]
  links            ImageLink[]
  posts            Post[]
  banners          Banner[]
  bannerTrans      BannerTranslation[]
  slides           Slide[]

  @@index([createdById], map: "ix_images_created_by_id")
  @@map("images")
}

model ImageTranslation {
  id         String @id(map: "pk_image_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageId    String @map("image_id") @db.Uuid
  image      Image  @relation(fields: [imageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_image_translations_image_id")
  localeCode String @map("locale_code") @db.VarChar(16)
  locale     Locale @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_image_translations_locale_code")
  alt        String @db.VarChar(255)

  @@unique([imageId, localeCode], map: "uq_image_translations_image_id_locale_code")
  @@index([localeCode], map: "ix_image_translations_locale_code")
  @@map("image_translations")
}

/// Polymorphic: `owner_id` points at a product, variant or category (validated in the before-event;
/// links are removed by the media module when the owner is deleted).
model ImageLink {
  id        String         @id(map: "pk_image_links") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageId   String         @map("image_id") @db.Uuid
  image     Image          @relation(fields: [imageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_image_links_image_id")
  ownerType ImageOwnerType @map("owner_type")
  ownerId   String         @map("owner_id") @db.Uuid
  role      ImageRole
  position  Int            @default(0)

  @@unique([imageId, ownerType, ownerId, role], map: "uq_image_links_image_id_owner_type_owner_id_role")
  @@index([ownerType, ownerId, position], map: "ix_image_links_owner_type_owner_id_position")
  @@map("image_links")
}

enum UrlTargetType {
  PRODUCT
  CATEGORY
  CUSTOM
  CMS_PAGE
  CMS_POST
}

/// Storefront URL → entity, per store and locale. System rows are regenerated from slugs; when a slug
/// changes the old path stays as a 301 to the entity. CUSTOM rows are admin-managed redirects.
model UrlRewrite {
  id           String        @id(map: "pk_url_rewrites") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String        @map("store_id") @db.Uuid
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_url_rewrites_store_id")
  localeCode   String        @map("locale_code") @db.VarChar(16)
  locale       Locale        @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_url_rewrites_locale_code")
  requestPath  String        @map("request_path") @db.VarChar(512)
  targetType   UrlTargetType @map("target_type")
  targetId     String?       @map("target_id") @db.Uuid
  /// CUSTOM redirects only.
  targetPath   String?       @map("target_path") @db.VarChar(512)
  /// NULL = canonical URL of the target; 301/302 = redirect.
  redirectType Int?          @map("redirect_type") @db.SmallInt
  isSystem     Boolean       @default(true) @map("is_system")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([storeId, localeCode, requestPath], map: "uq_url_rewrites_store_id_locale_code_request_path")
  @@index([targetType, targetId], map: "ix_url_rewrites_target_type_target_id")
  @@index([localeCode], map: "ix_url_rewrites_locale_code")
  @@map("url_rewrites")
}

// ───────────────────────────── Phase 2 — customer groups & tax ─────────────────────────────

enum TaxClassType {
  PRODUCT
  CUSTOMER
}

/// `standard`, `reduced`, `zero` (products); `retail`, `business` (customers).
model TaxClass {
  id              String           @id(map: "pk_tax_classes") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique(map: "uq_tax_classes_code") @db.VarChar(64)
  name            String           @db.VarChar(255)
  type            TaxClassType
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  products        Product[]
  customerGroups  CustomerGroup[]
  productRates    TaxRate[]        @relation("RateProductClass")
  customerRates   TaxRate[]        @relation("RateCustomerClass")
  shippingMethods ShippingMethod[]

  @@map("tax_classes")
}

/// Drives price books and the customer tax class. `guest` is used for anonymous shoppers.
model CustomerGroup {
  id         String       @id(map: "pk_customer_groups") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String       @unique(map: "uq_customer_groups_code") @db.VarChar(64)
  name       String       @db.VarChar(255)
  /// NULL = the `retail` customer tax class.
  taxClassId String?      @map("tax_class_id") @db.Uuid
  taxClass   TaxClass?    @relation(fields: [taxClassId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_customer_groups_tax_class_id")
  isSystem   Boolean      @default(false) @map("is_system")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  priceBooks PriceBook[]
  priceIndex PriceIndex[]
  customers  Customer[]

  @@index([taxClassId], map: "ix_customer_groups_tax_class_id")
  @@map("customer_groups")
}

/// A tax jurisdiction: one or more country / region / postcode matchers.
model TaxZone {
  id        String          @id(map: "pk_tax_zones") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String          @unique(map: "uq_tax_zones_code") @db.VarChar(64)
  name      String          @db.VarChar(255)
  /// Rounding of tax amounts: per line or on the order total (distributed to lines).
  rounding  String          @default("LINE") @db.VarChar(8)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  regions   TaxZoneRegion[]
  rates     TaxRate[]

  @@map("tax_zones")
}

model TaxZoneRegion {
  id              String  @id(map: "pk_tax_zone_regions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId          String  @map("zone_id") @db.Uuid
  zone            TaxZone @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_tax_zone_regions_zone_id")
  countryCode     String  @map("country_code") @db.Char(2)
  /// ISO 3166-2 subdivision without the country (`CA` for California); NULL = whole country.
  regionCode      String? @map("region_code") @db.VarChar(16)
  /// `*` wildcard pattern (`900*`); NULL = any postcode.
  postcodePattern String? @map("postcode_pattern") @db.VarChar(32)

  @@index([zoneId], map: "ix_tax_zone_regions_zone_id")
  @@index([countryCode, regionCode], map: "ix_tax_zone_regions_country_code_region_code")
  @@map("tax_zone_regions")
}

/// Date-effective rate for zone × product class (× customer class). New rates are added with
/// `valid_from`; old ones end with `valid_to`, so history is never rewritten.
model TaxRate {
  id                 String    @id(map: "pk_tax_rates") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId             String    @map("zone_id") @db.Uuid
  zone               TaxZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_tax_rates_zone_id")
  productTaxClassId  String    @map("product_tax_class_id") @db.Uuid
  productTaxClass    TaxClass  @relation("RateProductClass", fields: [productTaxClassId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_tax_rates_product_tax_class_id")
  /// NULL = every customer class.
  customerTaxClassId String?   @map("customer_tax_class_id") @db.Uuid
  customerTaxClass   TaxClass? @relation("RateCustomerClass", fields: [customerTaxClassId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_tax_rates_customer_tax_class_id")
  name               String    @db.VarChar(100)
  /// Percent, e.g. 19.0000.
  rate               Decimal   @db.Decimal(7, 4)
  priority           Int       @default(0)
  /// Applied on net + the taxes of lower priorities (e.g. Québec before 2013).
  isCompound         Boolean   @default(false) @map("is_compound")
  validFrom          DateTime  @default(dbgenerated("'1970-01-01'::date")) @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([zoneId, productTaxClassId], map: "ix_tax_rates_zone_id_product_tax_class_id")
  @@index([productTaxClassId], map: "ix_tax_rates_product_tax_class_id")
  @@index([customerTaxClassId], map: "ix_tax_rates_customer_tax_class_id")
  @@map("tax_rates")
}

// ───────────────────────────── Phase 2 — pricing ─────────────────────────────

/// A list of prices in one currency, scoped by website/store, customer group and dates.
/// Among matching books the lowest `priority` wins, then the most specific scope.
model PriceBook {
  id              String           @id(map: "pk_price_books") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique(map: "uq_price_books_code") @db.VarChar(64)
  name            String           @db.VarChar(255)
  currencyCode    String           @map("currency_code") @db.Char(3)
  currency        Currency         @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_price_books_currency_code")
  websiteId       String?          @map("website_id") @db.Uuid
  website         Website?         @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_books_website_id")
  storeId         String?          @map("store_id") @db.Uuid
  store           Store?           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_books_store_id")
  customerGroupId String?          @map("customer_group_id") @db.Uuid
  customerGroup   CustomerGroup?   @relation(fields: [customerGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_books_customer_group_id")
  /// Amounts are entered tax-inclusive (EU/VN style) or net (US style).
  includesTax     Boolean          @default(false) @map("includes_tax")
  priority        Int              @default(100)
  validFrom       DateTime?        @map("valid_from") @db.Timestamptz(3)
  validTo         DateTime?        @map("valid_to") @db.Timestamptz(3)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  entries         PriceBookEntry[]
  indexRows       PriceIndex[]

  @@index([currencyCode], map: "ix_price_books_currency_code")
  @@index([websiteId], map: "ix_price_books_website_id")
  @@index([storeId], map: "ix_price_books_store_id")
  @@index([customerGroupId], map: "ix_price_books_customer_group_id")
  @@map("price_books")
}

/// Unit price of a variant from `min_qty` (tier pricing). `compare_at_amount` = "was" price.
model PriceBookEntry {
  id              String         @id(map: "pk_price_book_entries") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  priceBookId     String         @map("price_book_id") @db.Uuid
  priceBook       PriceBook      @relation(fields: [priceBookId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_book_entries_price_book_id")
  variantId       String         @map("variant_id") @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_book_entries_variant_id")
  minQty          Int            @default(1) @map("min_qty")
  amount          BigInt
  compareAtAmount BigInt?        @map("compare_at_amount")
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([priceBookId, variantId, minQty], map: "uq_price_book_entries_price_book_id_variant_id_min_qty")
  @@index([variantId], map: "ix_price_book_entries_variant_id")
  @@map("price_book_entries")
}

/// Precomputed effective price per variant × store × customer group × currency × qty tier, with net
/// and gross for the store's default tax destination. Rebuilt by the price-index worker.
model PriceIndex {
  id              String         @id(map: "pk_price_index") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId       String         @map("variant_id") @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_index_variant_id")
  storeId         String         @map("store_id") @db.Uuid
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_index_store_id")
  customerGroupId String         @map("customer_group_id") @db.Uuid
  customerGroup   CustomerGroup  @relation(fields: [customerGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_index_customer_group_id")
  currencyCode    String         @map("currency_code") @db.Char(3)
  currency        Currency       @relation(fields: [currencyCode], references: [code], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_index_currency_code")
  minQty          Int            @default(1) @map("min_qty")
  netAmount       BigInt         @map("net_amount")
  grossAmount     BigInt         @map("gross_amount")
  compareAtNet    BigInt?        @map("compare_at_net")
  compareAtGross  BigInt?        @map("compare_at_gross")
  /// Total tax rate applied for the default destination (percent).
  taxRate         Decimal        @default(0) @map("tax_rate") @db.Decimal(9, 4)
  priceBookId     String         @map("price_book_id") @db.Uuid
  priceBook       PriceBook      @relation(fields: [priceBookId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_index_price_book_id")
  indexedAt       DateTime       @default(now()) @map("indexed_at") @db.Timestamptz(3)

  @@unique([variantId, storeId, customerGroupId, currencyCode, minQty], map: "uq_price_index_variant_store_group_currency_qty")
  @@index([storeId, customerGroupId, currencyCode], map: "ix_price_index_store_id_customer_group_id_currency_code")
  @@index([customerGroupId], map: "ix_price_index_customer_group_id")
  @@index([currencyCode], map: "ix_price_index_currency_code")
  @@index([priceBookId], map: "ix_price_index_price_book_id")
  @@map("price_index")
}

/// Display conversion only (prices come from price books): 1 base = rate × quote.
model ExchangeRate {
  id                String   @id(map: "pk_exchange_rates") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baseCurrencyCode  String   @map("base_currency_code") @db.Char(3)
  baseCurrency      Currency @relation("RateBase", fields: [baseCurrencyCode], references: [code], onDelete: Cascade, onUpdate: Cascade, map: "fk_exchange_rates_base_currency_code")
  quoteCurrencyCode String   @map("quote_currency_code") @db.Char(3)
  quoteCurrency     Currency @relation("RateQuote", fields: [quoteCurrencyCode], references: [code], onDelete: Cascade, onUpdate: Cascade, map: "fk_exchange_rates_quote_currency_code")
  rate              Decimal  @db.Decimal(18, 8)
  validFrom         DateTime @default(now()) @map("valid_from") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([baseCurrencyCode, quoteCurrencyCode, validFrom], map: "uq_exchange_rates_base_quote_valid_from")
  @@index([quoteCurrencyCode], map: "ix_exchange_rates_quote_currency_code")
  @@map("exchange_rates")
}

// ───────────────────────────── Phase 2 — inventory ─────────────────────────────

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum MovementReason {
  RECEIPT
  ADJUSTMENT
  SALE
  RETURN
  CORRECTION
}

/// Warehouse / store / dropshipper (Magento MSI source).
model InventorySource {
  id           String                   @id(map: "pk_inventory_sources") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String                   @unique(map: "uq_inventory_sources_code") @db.VarChar(64)
  name         String                   @db.VarChar(255)
  countryCode  String                   @map("country_code") @db.Char(2)
  isActive     Boolean                  @default(true) @map("is_active")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  websites     WebsiteInventorySource[]
  stock        Inventory[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]

  @@map("inventory_sources")
}

/// Which sources sell into a website, in fulfilment order (lower priority first).
model WebsiteInventorySource {
  id        String          @id(map: "pk_website_inventory_sources") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId String          @map("website_id") @db.Uuid
  website   Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_website_inventory_sources_website_id")
  sourceId  String          @map("source_id") @db.Uuid
  source    InventorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_website_inventory_sources_source_id")
  priority  Int             @default(0)

  @@unique([websiteId, sourceId], map: "uq_website_inventory_sources_website_id_source_id")
  @@index([sourceId], map: "ix_website_inventory_sources_source_id")
  @@map("website_inventory_sources")
}

/// Stock of a variant at a source. salable = quantity − reserved − safety_stock.
model Inventory {
  id          String          @id(map: "pk_inventories") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId    String          @map("source_id") @db.Uuid
  source      InventorySource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_inventories_source_id")
  variantId   String          @map("variant_id") @db.Uuid
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_inventories_variant_id")
  quantity    Int             @default(0)
  reserved    Int             @default(0)
  safetyStock Int             @default(0) @map("safety_stock")
  version     Int             @default(0)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([sourceId, variantId], map: "uq_inventories_source_id_variant_id")
  @@index([variantId], map: "ix_inventories_variant_id")
  @@map("inventories")
}

/// Stock held for a cart/order until converted (sold), released or expired.
model InventoryReservation {
  id            String            @id(map: "pk_inventory_reservations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  variant       ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_inventory_reservations_variant_id")
  sourceId      String            @map("source_id") @db.Uuid
  source        InventorySource   @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_inventory_reservations_source_id")
  quantity      Int
  /// Groups the per-source rows of one reservation request.
  groupId       String            @map("group_id") @db.Uuid
  referenceType String            @map("reference_type") @db.VarChar(32)
  referenceId   String            @map("reference_id") @db.VarChar(64)
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([variantId], map: "ix_inventory_reservations_variant_id")
  @@index([sourceId], map: "ix_inventory_reservations_source_id")
  @@index([groupId], map: "ix_inventory_reservations_group_id")
  @@index([referenceType, referenceId], map: "ix_inventory_reservations_reference")
  @@index([expiresAt], where: raw("status = 'ACTIVE'::\"ReservationStatus\""), map: "ix_inventory_reservations_active_expires_at")
  @@map("inventory_reservations")
}

/// Append-only stock ledger: every change of `inventories.quantity`, with the resulting quantity.
/// RESTRICT on source and variant: history is never deleted (deactivate sources, disable variants).
model InventoryMovement {
  id            String          @id(map: "pk_inventory_movements") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId      String          @map("source_id") @db.Uuid
  source        InventorySource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_inventory_movements_source_id")
  variantId     String          @map("variant_id") @db.Uuid
  variant       ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_inventory_movements_variant_id")
  delta         Int
  quantityAfter Int             @map("quantity_after")
  reason        MovementReason
  reference     String?         @db.VarChar(128)
  note          String?         @db.VarChar(500)
  actorLabel    String          @map("actor_label") @db.VarChar(255)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([sourceId, variantId, createdAt], map: "ix_inventory_movements_source_id_variant_id_created_at")
  @@index([variantId], map: "ix_inventory_movements_variant_id")
  @@map("inventory_movements")
}

// ───────────────────────────── Phase 3 — search ─────────────────────────────

enum SearchProviderKind {
  POSTGRES
  ELASTICSEARCH
  OPENSEARCH
  MEILISEARCH
}

enum SearchBuildStatus {
  READY
  BUILDING
  FAILED
}

/// Search engine of a website (PLAN.md §9.5). Without a row the website uses Postgres. A switch builds
/// the `pending_*` engine's indexes under `pending_generation` while reads stay on the active one,
/// then flips atomically. Connections are sealed (AES-GCM, APP_ENCRYPTION_KEY).
model SearchSettings {
  id                String              @id(map: "pk_search_settings") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId         String              @unique(map: "uq_search_settings_website_id") @map("website_id") @db.Uuid
  website           Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_search_settings_website_id")
  provider          SearchProviderKind  @default(POSTGRES)
  connection        String?
  indexPrefix       String              @default("shop") @map("index_prefix") @db.VarChar(32)
  /// Groups of equivalent terms: [["tee", "t-shirt"], …]
  synonyms          Json                @default("[]")
  stopwords         Json                @default("[]")
  activeGeneration  Int                 @default(0) @map("active_generation")
  pendingProvider   SearchProviderKind? @map("pending_provider")
  pendingConnection String?             @map("pending_connection")
  pendingGeneration Int?                @map("pending_generation")
  status            SearchBuildStatus   @default(READY)
  lastError         String?             @map("last_error")
  buildStartedAt    DateTime?           @map("build_started_at") @db.Timestamptz(3)
  lastBuiltAt       DateTime?           @map("last_built_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("search_settings")
}

/// The search projection: one document per product × store × locale with a weighted tsvector.
/// Always maintained, so Postgres can serve search when an external engine is down.
model SearchDocument {
  id           String                   @id(map: "pk_search_documents") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String                   @map("store_id") @db.Uuid
  store        Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_search_documents_store_id")
  localeCode   String                   @map("locale_code") @db.VarChar(16)
  locale       Locale                   @relation(fields: [localeCode], references: [code], onDelete: Cascade, onUpdate: Cascade, map: "fk_search_documents_locale_code")
  entityType   String                   @default("PRODUCT") @map("entity_type") @db.VarChar(16)
  entityId     String                   @map("entity_id") @db.Uuid
  document     Json
  searchVector Unsupported("tsvector")? @map("search_vector")
  updatedAt    DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([storeId, localeCode, entityType, entityId], map: "uq_search_documents_store_locale_entity")
  @@index([searchVector], type: Gin, map: "ix_search_documents_search_vector")
  @@index([document(ops: JsonbPathOps)], type: Gin, map: "ix_search_documents_document")
  @@index([entityType, entityId], map: "ix_search_documents_entity")
  @@index([localeCode], map: "ix_search_documents_locale_code")
  @@index([storeId, updatedAt], map: "ix_search_documents_store_id_updated_at")
  @@map("search_documents")
}

// ───────────────────────────── Phase 4 — CMS, navigation, merchandising, scheduler ─────────────────────────────

/// Publishing state shared by pages, posts, blocks, banners and sliders. Storefront reads also check
/// `published_at` / `unpublished_at`, so content appears and disappears on time even if the scheduler lags.
enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  PAGE
  POST
  BLOCK
  BANNER
  SLIDER
  CAMPAIGN
  PROMOTION
}

enum ScheduleAction {
  PUBLISH
  UNPUBLISH
}

enum ScheduleStatus {
  PENDING
  DONE
  FAILED
  CANCELLED
}

enum BlockTargetType {
  PAGE
  POST
  CATEGORY
  PRODUCT
}

enum MenuLinkType {
  URL
  PAGE
  POST
  CATEGORY
  PRODUCT
}

/// CMS page. `store_id` NULL = every store (a store-specific page with the same slug wins).
model Page {
  id            String            @id(map: "pk_pages") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String?           @map("store_id") @db.Uuid
  store         Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_pages_store_id")
  status        ContentStatus     @default(DRAFT)
  layout        String            @default("default") @db.VarChar(64)
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(3)
  unpublishedAt DateTime?         @map("unpublished_at") @db.Timestamptz(3)
  createdById   String?           @map("created_by_id") @db.Uuid
  createdBy     AdminUser?        @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_pages_created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations  PageTranslation[]

  @@index([storeId], map: "ix_pages_store_id")
  @@index([createdById], map: "ix_pages_created_by_id")
  @@index([status, publishedAt], map: "ix_pages_status_published_at")
  @@map("pages")
}

model PageTranslation {
  id              String  @id(map: "pk_page_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId          String  @map("page_id") @db.Uuid
  page            Page    @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_page_translations_page_id")
  localeCode      String  @map("locale_code") @db.VarChar(16)
  locale          Locale  @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_page_translations_locale_code")
  title           String  @db.VarChar(255)
  slug            String  @db.VarChar(255)
  /// Sanitized HTML; may contain {{block id="…"}} tokens.
  content         String  @default("")
  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.VarChar(512)

  @@unique([pageId, localeCode], map: "uq_page_translations_page_id_locale_code")
  @@index([localeCode, slug], map: "ix_page_translations_locale_code_slug")
  @@map("page_translations")
}

model Post {
  id              String            @id(map: "pk_posts") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String?           @map("store_id") @db.Uuid
  store           Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_posts_store_id")
  status          ContentStatus     @default(DRAFT)
  publishedAt     DateTime?         @map("published_at") @db.Timestamptz(3)
  unpublishedAt   DateTime?         @map("unpublished_at") @db.Timestamptz(3)
  authorId        String?           @map("author_id") @db.Uuid
  author          AdminUser?        @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_posts_author_id")
  featuredImageId String?           @map("featured_image_id") @db.Uuid
  featuredImage   Image?            @relation(fields: [featuredImageId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_posts_featured_image_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations    PostTranslation[]
  tags            PostTag[]

  @@index([storeId], map: "ix_posts_store_id")
  @@index([authorId], map: "ix_posts_author_id")
  @@index([featuredImageId], map: "ix_posts_featured_image_id")
  @@index([status, publishedAt], map: "ix_posts_status_published_at")
  @@map("posts")
}

model PostTranslation {
  id              String  @id(map: "pk_post_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId          String  @map("post_id") @db.Uuid
  post            Post    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_post_translations_post_id")
  localeCode      String  @map("locale_code") @db.VarChar(16)
  locale          Locale  @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_post_translations_locale_code")
  title           String  @db.VarChar(255)
  slug            String  @db.VarChar(255)
  excerpt         String? @db.VarChar(1000)
  content         String  @default("")
  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.VarChar(512)

  @@unique([postId, localeCode], map: "uq_post_translations_post_id_locale_code")
  @@index([localeCode, slug], map: "ix_post_translations_locale_code_slug")
  @@map("post_translations")
}

model Tag {
  id           String           @id(map: "pk_tags") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String           @unique(map: "uq_tags_code") @db.VarChar(64)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations TagTranslation[]
  posts        PostTag[]

  @@map("tags")
}

model TagTranslation {
  id         String @id(map: "pk_tag_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tagId      String @map("tag_id") @db.Uuid
  tag        Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_tag_translations_tag_id")
  localeCode String @map("locale_code") @db.VarChar(16)
  locale     Locale @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_tag_translations_locale_code")
  name       String @db.VarChar(100)

  @@unique([tagId, localeCode], map: "uq_tag_translations_tag_id_locale_code")
  @@index([localeCode], map: "ix_tag_translations_locale_code")
  @@map("tag_translations")
}

model PostTag {
  id     String @id(map: "pk_post_tags") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_post_tags_post_id")
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_post_tags_tag_id")

  @@unique([postId, tagId], map: "uq_post_tags_post_id_tag_id")
  @@index([tagId], map: "ix_post_tags_tag_id")
  @@map("post_tags")
}

/// Reusable content snippet, injected with {{block id="identifier"}} or placed in regions.
model Block {
  id            String             @id(map: "pk_blocks") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier    String             @db.VarChar(64)
  storeId       String?            @map("store_id") @db.Uuid
  store         Store?             @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_blocks_store_id")
  status        ContentStatus      @default(DRAFT)
  publishedAt   DateTime?          @map("published_at") @db.Timestamptz(3)
  unpublishedAt DateTime?          @map("unpublished_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations  BlockTranslation[]
  placements    BlockPlacement[]

  @@unique([identifier], where: raw("store_id IS NULL"), map: "uq_blocks_identifier_global")
  @@unique([identifier, storeId], where: raw("store_id IS NOT NULL"), map: "uq_blocks_identifier_store_id")
  @@index([storeId], map: "ix_blocks_store_id")
  @@map("blocks")
}

model BlockTranslation {
  id         String  @id(map: "pk_block_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId    String  @map("block_id") @db.Uuid
  block      Block   @relation(fields: [blockId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_block_translations_block_id")
  localeCode String  @map("locale_code") @db.VarChar(16)
  locale     Locale  @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_block_translations_locale_code")
  title      String? @db.VarChar(255)
  content    String  @default("")

  @@unique([blockId, localeCode], map: "uq_block_translations_block_id_locale_code")
  @@index([localeCode], map: "ix_block_translations_locale_code")
  @@map("block_translations")
}

/// A block shown in a region of a page, post, category or product (polymorphic target, validated by
/// the owning module's before-event; removed when the target is deleted).
model BlockPlacement {
  id         String          @id(map: "pk_block_placements") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId    String          @map("block_id") @db.Uuid
  block      Block           @relation(fields: [blockId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_block_placements_block_id")
  targetType BlockTargetType @map("target_type")
  targetId   String          @map("target_id") @db.Uuid
  region     String          @db.VarChar(64)
  position   Int             @default(0)

  @@unique([blockId, targetType, targetId, region], map: "uq_block_placements_block_target_region")
  @@index([targetType, targetId, region, position], map: "ix_block_placements_target_region_position")
  @@map("block_placements")
}

model Menu {
  id        String     @id(map: "pk_menus") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String     @db.VarChar(64)
  name      String     @db.VarChar(255)
  storeId   String?    @map("store_id") @db.Uuid
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_menus_store_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     MenuItem[]

  @@unique([code], where: raw("store_id IS NULL"), map: "uq_menus_code_global")
  @@unique([code, storeId], where: raw("store_id IS NOT NULL"), map: "uq_menus_code_store_id")
  @@index([storeId], map: "ix_menus_store_id")
  @@map("menus")
}

model MenuItem {
  id           String                @id(map: "pk_menu_items") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuId       String                @map("menu_id") @db.Uuid
  menu         Menu                  @relation(fields: [menuId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_menu_items_menu_id")
  parentId     String?               @map("parent_id") @db.Uuid
  parent       MenuItem?             @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_menu_items_parent_id")
  children     MenuItem[]            @relation("MenuTree")
  position     Int                   @default(0)
  linkType     MenuLinkType          @map("link_type")
  /// Page, post, category or product id (polymorphic; links to missing targets are hidden).
  targetId     String?               @map("target_id") @db.Uuid
  url          String?               @db.VarChar(512)
  openInNewTab Boolean               @default(false) @map("open_in_new_tab")
  isActive     Boolean               @default(true) @map("is_active")
  translations MenuItemTranslation[]

  @@index([menuId, parentId, position], map: "ix_menu_items_menu_id_parent_id_position")
  @@index([parentId], map: "ix_menu_items_parent_id")
  @@map("menu_items")
}

model MenuItemTranslation {
  id         String   @id(map: "pk_menu_item_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_menu_item_translations_item_id")
  localeCode String   @map("locale_code") @db.VarChar(16)
  locale     Locale   @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_menu_item_translations_locale_code")
  label      String   @db.VarChar(255)

  @@unique([itemId, localeCode], map: "uq_menu_item_translations_item_id_locale_code")
  @@index([localeCode], map: "ix_menu_item_translations_locale_code")
  @@map("menu_item_translations")
}

model Banner {
  id            String              @id(map: "pk_banners") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placement     String              @db.VarChar(64)
  name          String              @db.VarChar(255)
  storeId       String?             @map("store_id") @db.Uuid
  store         Store?              @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_banners_store_id")
  status        ContentStatus       @default(DRAFT)
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz(3)
  unpublishedAt DateTime?           @map("unpublished_at") @db.Timestamptz(3)
  position      Int                 @default(0)
  linkUrl       String?             @map("link_url") @db.VarChar(512)
  imageId       String?             @map("image_id") @db.Uuid
  image         Image?              @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_banners_image_id")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations  BannerTranslation[]

  @@index([placement, position], map: "ix_banners_placement_position")
  @@index([storeId], map: "ix_banners_store_id")
  @@index([imageId], map: "ix_banners_image_id")
  @@map("banners")
}

model BannerTranslation {
  id         String  @id(map: "pk_banner_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bannerId   String  @map("banner_id") @db.Uuid
  banner     Banner  @relation(fields: [bannerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_banner_translations_banner_id")
  localeCode String  @map("locale_code") @db.VarChar(16)
  locale     Locale  @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_banner_translations_locale_code")
  title      String? @db.VarChar(255)
  subtitle   String? @db.VarChar(500)
  ctaLabel   String? @map("cta_label") @db.VarChar(100)
  /// Locale-specific artwork (text baked into the image); falls back to the banner's image.
  imageId    String? @map("image_id") @db.Uuid
  image      Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_banner_translations_image_id")

  @@unique([bannerId, localeCode], map: "uq_banner_translations_banner_id_locale_code")
  @@index([localeCode], map: "ix_banner_translations_locale_code")
  @@index([imageId], map: "ix_banner_translations_image_id")
  @@map("banner_translations")
}

model Slider {
  id            String        @id(map: "pk_sliders") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String        @db.VarChar(64)
  name          String        @db.VarChar(255)
  storeId       String?       @map("store_id") @db.Uuid
  store         Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_sliders_store_id")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(3)
  unpublishedAt DateTime?     @map("unpublished_at") @db.Timestamptz(3)
  autoplayMs    Int?          @map("autoplay_ms")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  slides        Slide[]

  @@unique([code], where: raw("store_id IS NULL"), map: "uq_sliders_code_global")
  @@unique([code, storeId], where: raw("store_id IS NOT NULL"), map: "uq_sliders_code_store_id")
  @@index([storeId], map: "ix_sliders_store_id")
  @@map("sliders")
}

model Slide {
  id           String             @id(map: "pk_slides") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sliderId     String             @map("slider_id") @db.Uuid
  slider       Slider             @relation(fields: [sliderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_slides_slider_id")
  imageId      String?            @map("image_id") @db.Uuid
  image        Image?             @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_slides_image_id")
  position     Int                @default(0)
  linkUrl      String?            @map("link_url") @db.VarChar(512)
  isActive     Boolean            @default(true) @map("is_active")
  translations SlideTranslation[]

  @@index([sliderId, position], map: "ix_slides_slider_id_position")
  @@index([imageId], map: "ix_slides_image_id")
  @@map("slides")
}

model SlideTranslation {
  id         String  @id(map: "pk_slide_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slideId    String  @map("slide_id") @db.Uuid
  slide      Slide   @relation(fields: [slideId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_slide_translations_slide_id")
  localeCode String  @map("locale_code") @db.VarChar(16)
  locale     Locale  @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_slide_translations_locale_code")
  title      String? @db.VarChar(255)
  caption    String? @db.VarChar(1000)
  ctaLabel   String? @map("cta_label") @db.VarChar(100)

  @@unique([slideId, localeCode], map: "uq_slide_translations_slide_id_locale_code")
  @@index([localeCode], map: "ix_slide_translations_locale_code")
  @@map("slide_translations")
}

/// Publish/unpublish at a time (PLAN.md §9 scheduler). One pending row per target and action; the
/// worker claims due rows with SKIP LOCKED and emits `schedule.due` for the owning module.
model Schedule {
  id          String         @id(map: "pk_schedules") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType  ContentType    @map("target_type")
  targetId    String         @map("target_id") @db.Uuid
  action      ScheduleAction
  runAt       DateTime       @map("run_at") @db.Timestamptz(3)
  status      ScheduleStatus @default(PENDING)
  attempts    Int            @default(0)
  executedAt  DateTime?      @map("executed_at") @db.Timestamptz(3)
  error       String?
  createdById String?        @map("created_by_id") @db.Uuid
  createdBy   AdminUser?     @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_schedules_created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([targetType, targetId, action], where: raw("status = 'PENDING'::\"ScheduleStatus\""), map: "uq_schedules_pending_target_action")
  @@index([runAt], where: raw("status = 'PENDING'::\"ScheduleStatus\""), map: "ix_schedules_pending_run_at")
  @@index([targetType, targetId], map: "ix_schedules_target")
  @@index([createdById], map: "ix_schedules_created_by_id")
  @@map("schedules")
}

// ───────────────────────────── Phase 5 — customers, marketing, loyalty ─────────────────────────────

enum CustomerStatus {
  ACTIVE
  DISABLED
}

/// A shopper account. Accounts belong to a website (Magento "account sharing: per website"): the
/// same e-mail can have separate accounts on separate websites.
model Customer {
  id                String            @id(map: "pk_customers") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId         String            @map("website_id") @db.Uuid
  website           Website           @relation(fields: [websiteId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_customers_website_id")
  email             String            @db.Citext
  passwordHash      String            @map("password_hash") @db.VarChar(255)
  firstName         String            @map("first_name") @db.VarChar(100)
  lastName          String            @map("last_name") @db.VarChar(100)
  phone             String?           @db.VarChar(32)
  customerGroupId   String            @map("customer_group_id") @db.Uuid
  customerGroup     CustomerGroup     @relation(fields: [customerGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_customers_customer_group_id")
  localeCode        String?           @map("locale_code") @db.VarChar(16)
  locale            Locale?           @relation(fields: [localeCode], references: [code], onDelete: SetNull, onUpdate: Cascade, map: "fk_customers_locale_code")
  status            CustomerStatus    @default(ACTIVE)
  acceptsMarketing  Boolean           @default(false) @map("accepts_marketing")
  failedLogins      Int               @default(0) @map("failed_logins")
  lockedUntil       DateTime?         @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?         @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime          @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  addresses         CustomerAddress[]
  sessions          CustomerSession[]
  loyaltyAccount    LoyaltyAccount?
  promotionUsages   PromotionUsage[]
  carts             Cart[]
  orders            Order[]

  @@unique([websiteId, email], map: "uq_customers_website_id_email")
  @@index([customerGroupId], map: "ix_customers_customer_group_id")
  @@index([localeCode], map: "ix_customers_locale_code")
  @@index([createdAt], map: "ix_customers_created_at")
  @@map("customers")
}

model CustomerAddress {
  id                String   @id(map: "pk_customer_addresses") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_customer_addresses_customer_id")
  firstName         String   @map("first_name") @db.VarChar(100)
  lastName          String   @map("last_name") @db.VarChar(100)
  company           String?  @db.VarChar(255)
  phone             String?  @db.VarChar(32)
  countryCode       String   @map("country_code") @db.Char(2)
  regionCode        String?  @map("region_code") @db.VarChar(16)
  city              String   @db.VarChar(100)
  postcode          String?  @db.VarChar(20)
  line1             String   @db.VarChar(255)
  line2             String?  @db.VarChar(255)
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([customerId], where: raw("is_default_shipping"), map: "uq_customer_addresses_default_shipping")
  @@unique([customerId], where: raw("is_default_billing"), map: "uq_customer_addresses_default_billing")
  @@index([customerId], map: "ix_customer_addresses_customer_id")
  @@map("customer_addresses")
}

/// Rotating refresh tokens of storefront sessions (same scheme as the admin's `refresh_tokens`).
model CustomerSession {
  id           String            @id(map: "pk_customer_sessions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String            @map("customer_id") @db.Uuid
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_customer_sessions_customer_id")
  familyId     String            @map("family_id") @db.Uuid
  tokenHash    String            @unique(map: "uq_customer_sessions_token_hash") @map("token_hash") @db.Char(64)
  replacedById String?           @map("replaced_by_id") @db.Uuid
  replacedBy   CustomerSession?  @relation("CustomerSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_customer_sessions_replaced_by_id")
  replaces     CustomerSession[] @relation("CustomerSessionRotation")
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?         @map("revoked_at") @db.Timestamptz(3)
  userAgent    String?           @map("user_agent") @db.VarChar(255)
  ip           String?           @db.VarChar(64)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId], map: "ix_customer_sessions_customer_id")
  @@index([familyId], map: "ix_customer_sessions_family_id")
  @@index([replacedById], map: "ix_customer_sessions_replaced_by_id")
  @@index([expiresAt], map: "ix_customer_sessions_expires_at")
  @@map("customer_sessions")
}

/// One marketing push. Its publishing window gates its promotions (and so their coupons).
model Campaign {
  id                 String        @id(map: "pk_campaigns") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String        @unique(map: "uq_campaigns_code") @db.VarChar(64)
  name               String        @db.VarChar(255)
  description        String?       @db.VarChar(2000)
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?     @map("published_at") @db.Timestamptz(3)
  unpublishedAt      DateTime?     @map("unpublished_at") @db.Timestamptz(3)
  budgetAmount       BigInt?       @map("budget_amount")
  budgetCurrencyCode String?       @map("budget_currency_code") @db.Char(3)
  budgetCurrency     Currency?     @relation(fields: [budgetCurrencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_campaigns_budget_currency_code")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  promotions         Promotion[]

  @@index([budgetCurrencyCode], map: "ix_campaigns_budget_currency_code")
  @@index([status, publishedAt], map: "ix_campaigns_status_published_at")
  @@map("campaigns")
}

/// A cart price rule: typed conditions and actions (JSONB, validated on save), evaluated by priority.
model Promotion {
  id              String                 @id(map: "pk_promotions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId      String?                @map("campaign_id") @db.Uuid
  campaign        Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_promotions_campaign_id")
  name            String                 @db.VarChar(255)
  description     String?                @db.VarChar(2000)
  status          ContentStatus          @default(DRAFT)
  publishedAt     DateTime?              @map("published_at") @db.Timestamptz(3)
  unpublishedAt   DateTime?              @map("unpublished_at") @db.Timestamptz(3)
  priority        Int                    @default(0)
  stopFurther     Boolean                @default(false) @map("stop_further")
  requiresCoupon  Boolean                @default(false) @map("requires_coupon")
  conditions      Json                   @default("[]")
  actions         Json                   @default("[]")
  usageLimit      Int?                   @map("usage_limit")
  usesPerCustomer Int?                   @map("uses_per_customer")
  timesUsed       Int                    @default(0) @map("times_used")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  websites        PromotionWebsite[]
  translations    PromotionTranslation[]
  coupons         Coupon[]
  usages          PromotionUsage[]

  @@index([campaignId], map: "ix_promotions_campaign_id")
  @@index([status, publishedAt], map: "ix_promotions_status_published_at")
  @@map("promotions")
}

model PromotionWebsite {
  id          String    @id(map: "pk_promotion_websites") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_promotion_websites_promotion_id")
  websiteId   String    @map("website_id") @db.Uuid
  website     Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_promotion_websites_website_id")

  @@unique([promotionId, websiteId], map: "uq_promotion_websites_promotion_id_website_id")
  @@index([websiteId], map: "ix_promotion_websites_website_id")
  @@map("promotion_websites")
}

/// The label shoppers see in the cart ("10% off summer tees").
model PromotionTranslation {
  id          String    @id(map: "pk_promotion_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_promotion_translations_promotion_id")
  localeCode  String    @map("locale_code") @db.VarChar(16)
  locale      Locale    @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_promotion_translations_locale_code")
  label       String    @db.VarChar(255)

  @@unique([promotionId, localeCode], map: "uq_promotion_translations_promotion_id_locale_code")
  @@index([localeCode], map: "ix_promotion_translations_locale_code")
  @@map("promotion_translations")
}

model Coupon {
  id              String           @id(map: "pk_coupons") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId     String           @map("promotion_id") @db.Uuid
  promotion       Promotion        @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_coupons_promotion_id")
  /// Case-insensitive and unique across all promotions.
  code            String           @unique(map: "uq_coupons_code") @db.Citext
  usageLimit      Int?             @map("usage_limit")
  usesPerCustomer Int?             @map("uses_per_customer")
  timesUsed       Int              @default(0) @map("times_used")
  expiresAt       DateTime?        @map("expires_at") @db.Timestamptz(3)
  isActive        Boolean          @default(true) @map("is_active")
  /// Generated in bulk together (null = created one by one).
  batchId         String?          @map("batch_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  usages          PromotionUsage[]

  @@index([promotionId], map: "ix_coupons_promotion_id")
  @@index([batchId], map: "ix_coupons_batch_id")
  @@map("coupons")
}

enum PromotionUsageStatus {
  APPLIED
  RELEASED
}

/// A promotion (and its coupon) used by an order. Released when the order is cancelled.
model PromotionUsage {
  id           String               @id(map: "pk_promotion_usages") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId  String               @map("promotion_id") @db.Uuid
  promotion    Promotion            @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_promotion_usages_promotion_id")
  couponId     String?              @map("coupon_id") @db.Uuid
  coupon       Coupon?              @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_promotion_usages_coupon_id")
  customerId   String?              @map("customer_id") @db.Uuid
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_promotion_usages_customer_id")
  orderRef     String               @map("order_ref") @db.VarChar(64)
  discount     BigInt               @default(0)
  currencyCode String               @map("currency_code") @db.Char(3)
  status       PromotionUsageStatus @default(APPLIED)
  releasedAt   DateTime?            @map("released_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([promotionId, orderRef], map: "uq_promotion_usages_promotion_id_order_ref")
  @@index([couponId], map: "ix_promotion_usages_coupon_id")
  @@index([customerId], map: "ix_promotion_usages_customer_id")
  @@index([orderRef], map: "ix_promotion_usages_order_ref")
  @@map("promotion_usages")
}

/// Loyalty rules of one website: how points are earned, what they are worth, when they expire.
model LoyaltyProgram {
  id               String           @id(map: "pk_loyalty_programs") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId        String           @unique(map: "uq_loyalty_programs_website_id") @map("website_id") @db.Uuid
  website          Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_loyalty_programs_website_id")
  name             String           @db.VarChar(255)
  currencyCode     String           @map("currency_code") @db.Char(3)
  currency         Currency         @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_loyalty_programs_currency_code")
  /// Minor units of spend per point (100 = 1 point per $1).
  spendPerPoint    BigInt           @map("spend_per_point")
  /// Minor units a redeemed point is worth (1 = 1 cent).
  pointValue       BigInt           @map("point_value")
  minRedeemPoints  Int              @default(0) @map("min_redeem_points")
  /// Share of an order that points may pay (1–100).
  maxRedeemPercent Int              @default(100) @map("max_redeem_percent")
  /// Earned points expire after this many days (null = never).
  expiryDays       Int?             @map("expiry_days")
  /// Tiers are decided by points earned in this rolling window.
  tierWindowDays   Int              @default(365) @map("tier_window_days")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tiers            LoyaltyTier[]
  accounts         LoyaltyAccount[]

  @@index([currencyCode], map: "ix_loyalty_programs_currency_code")
  @@map("loyalty_programs")
}

model LoyaltyTier {
  id              String           @id(map: "pk_loyalty_tiers") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId       String           @map("program_id") @db.Uuid
  program         LoyaltyProgram   @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_loyalty_tiers_program_id")
  code            String           @db.VarChar(64)
  name            String           @db.VarChar(255)
  /// Points earned within the program's window needed to reach the tier.
  thresholdPoints Int              @map("threshold_points")
  /// Earn multiplier in basis points (10000 = ×1, 15000 = ×1.5).
  multiplierBp    Int              @default(10000) @map("multiplier_bp")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  accounts        LoyaltyAccount[]

  @@unique([programId, code], map: "uq_loyalty_tiers_program_id_code")
  @@unique([programId, thresholdPoints], map: "uq_loyalty_tiers_program_id_threshold_points")
  @@map("loyalty_tiers")
}

/// Points of one customer. `balance` caches the sum of the ledger (kept in the same transaction).
model LoyaltyAccount {
  id             String               @id(map: "pk_loyalty_accounts") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId      String               @map("program_id") @db.Uuid
  program        LoyaltyProgram       @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_loyalty_accounts_program_id")
  customerId     String               @unique(map: "uq_loyalty_accounts_customer_id") @map("customer_id") @db.Uuid
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_loyalty_accounts_customer_id")
  balance        Int                  @default(0)
  lifetimePoints Int                  @default(0) @map("lifetime_points")
  tierId         String?              @map("tier_id") @db.Uuid
  tier           LoyaltyTier?         @relation(fields: [tierId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_loyalty_accounts_tier_id")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  transactions   LoyaltyTransaction[]

  @@index([programId], map: "ix_loyalty_accounts_program_id")
  @@index([tierId], map: "ix_loyalty_accounts_tier_id")
  @@map("loyalty_accounts")
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REVERSE
}

/// Append-only ledger. Credits keep `remaining` (consumed FIFO by expiry date); debits record which
/// credits they consumed in `loyalty_allocations`, so a reversal can give exactly those back.
model LoyaltyTransaction {
  id           String                 @id(map: "pk_loyalty_transactions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId    String                 @map("account_id") @db.Uuid
  account      LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_loyalty_transactions_account_id")
  type         LoyaltyTransactionType
  points       Int
  remaining    Int                    @default(0)
  expiresAt    DateTime?              @map("expires_at") @db.Timestamptz(3)
  orderRef     String?                @map("order_ref") @db.VarChar(64)
  /// For EARN: the eligible amount the points were earned on (used for partial refunds).
  amount       BigInt?
  currencyCode String?                @map("currency_code") @db.Char(3)
  note         String?                @db.VarChar(500)
  actorLabel   String?                @map("actor_label") @db.VarChar(255)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  debits       LoyaltyAllocation[]    @relation("AllocationDebit")
  credits      LoyaltyAllocation[]    @relation("AllocationCredit")

  @@unique([accountId, type, orderRef], where: raw("type = ANY (ARRAY['EARN'::\"LoyaltyTransactionType\", 'REDEEM'::\"LoyaltyTransactionType\"]) AND order_ref IS NOT NULL"), map: "uq_loyalty_transactions_order_once")
  @@index([accountId, createdAt], map: "ix_loyalty_transactions_account_id_created_at")
  @@index([expiresAt], where: raw("remaining > 0"), map: "ix_loyalty_transactions_expiring")
  @@index([orderRef], map: "ix_loyalty_transactions_order_ref")
  @@map("loyalty_transactions")
}

/// Which credit rows a debit consumed (FIFO), and how many points from each.
model LoyaltyAllocation {
  id       String             @id(map: "pk_loyalty_allocations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  debitId  String             @map("debit_id") @db.Uuid
  debit    LoyaltyTransaction @relation("AllocationDebit", fields: [debitId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_loyalty_allocations_debit_id")
  creditId String             @map("credit_id") @db.Uuid
  credit   LoyaltyTransaction @relation("AllocationCredit", fields: [creditId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_loyalty_allocations_credit_id")
  points   Int

  @@unique([debitId, creditId], map: "uq_loyalty_allocations_debit_id_credit_id")
  @@index([creditId], map: "ix_loyalty_allocations_credit_id")
  @@map("loyalty_allocations")
}

// ───────────────────────────── Phase 6 — carts, orders, payments, fulfilment ─────────────────────────────

enum ShippingRateType {
  /// One amount per order.
  FLAT
  /// The amount times the number of units.
  PER_ITEM
}

/// A delivery option of a website (rates per currency, optional free-shipping threshold).
model ShippingMethod {
  id           String                      @id(map: "pk_shipping_methods") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId    String                      @map("website_id") @db.Uuid
  website      Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_shipping_methods_website_id")
  code         String                      @db.VarChar(64)
  carrier      String                      @db.VarChar(64)
  rateType     ShippingRateType            @default(FLAT) @map("rate_type")
  /// Minor units per currency, `{ "USD": 799 }` (tax-inclusive when the store shows inclusive prices).
  amounts      Json
  /// Free when the discounted subtotal reaches it, per currency.
  freeOver     Json?                       @map("free_over")
  /// Destination countries (empty = everywhere).
  countryCodes String[]                    @default([]) @map("country_codes") @db.Char(2)
  /// Product tax class applied to the shipping charge (null = not taxed).
  taxClassId   String?                     @map("tax_class_id") @db.Uuid
  taxClass     TaxClass?                   @relation(fields: [taxClassId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_shipping_methods_tax_class_id")
  position     Int                         @default(0)
  isActive     Boolean                     @default(true) @map("is_active")
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations ShippingMethodTranslation[]
  carts        Cart[]

  @@unique([websiteId, code], map: "uq_shipping_methods_website_id_code")
  @@index([taxClassId], map: "ix_shipping_methods_tax_class_id")
  @@map("shipping_methods")
}

model ShippingMethodTranslation {
  id          String         @id(map: "pk_shipping_method_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  methodId    String         @map("method_id") @db.Uuid
  method      ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_shipping_method_translations_method_id")
  localeCode  String         @map("locale_code") @db.VarChar(16)
  locale      Locale         @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_shipping_method_translations_locale_code")
  name        String         @db.VarChar(255)
  description String?        @db.VarChar(500)

  @@unique([methodId, localeCode], map: "uq_shipping_method_translations_method_id_locale_code")
  @@index([localeCode], map: "ix_shipping_method_translations_locale_code")
  @@map("shipping_method_translations")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  MERGED
}

/// A shopping cart: a guest's (opaque token, stored hashed) or a customer's (one active per store).
model Cart {
  id               String          @id(map: "pk_carts") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String          @map("store_id") @db.Uuid
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_carts_store_id")
  customerId       String?         @map("customer_id") @db.Uuid
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_carts_customer_id")
  tokenHash        String?         @unique(map: "uq_carts_token_hash") @map("token_hash") @db.Char(64)
  status           CartStatus      @default(ACTIVE)
  currencyCode     String          @map("currency_code") @db.Char(3)
  email            String?         @db.Citext
  couponCode       String?         @map("coupon_code") @db.VarChar(64)
  shippingAddress  Json?           @map("shipping_address")
  billingAddress   Json?           @map("billing_address")
  shippingMethodId String?         @map("shipping_method_id") @db.Uuid
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_carts_shipping_method_id")
  loyaltyPoints    Int             @default(0) @map("loyalty_points")
  version          Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  items            CartItem[]

  @@unique([storeId, customerId], where: raw("status = 'ACTIVE'::\"CartStatus\" AND customer_id IS NOT NULL"), map: "uq_carts_active_customer")
  @@index([customerId], map: "ix_carts_customer_id")
  @@index([shippingMethodId], map: "ix_carts_shipping_method_id")
  @@index([updatedAt], map: "ix_carts_updated_at")
  @@map("carts")
}

model CartItem {
  id        String         @id(map: "pk_cart_items") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_cart_items_cart_id")
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_cart_items_variant_id")
  quantity  Int
  /// Bundle choices `[{ "option": "shirt", "sku": "TEE-RED", "quantity": 1 }]`.
  options   Json           @default("[]")
  /// Canonical form of `options`: the same product with the same choices is one line.
  signature String         @default("") @db.VarChar(512)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([cartId, variantId, signature], map: "uq_cart_items_cart_id_variant_id_signature")
  @@index([variantId], map: "ix_cart_items_variant_id")
  @@map("cart_items")
}

/// Gap-free-enough counters for document numbers (`order:us`, `invoice:us:2026`), locked per scope.
model DocumentSequence {
  id        String   @id(map: "pk_document_sequences") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope     String   @unique(map: "uq_document_sequences_scope") @db.VarChar(64)
  nextValue BigInt   @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("document_sequences")
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  COMPLETE
  CANCELED
  CLOSED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

/// A placed order. Items, prices, tax and addresses are snapshots: later catalog or tax changes
/// never alter it.
model Order {
  id                 String                 @id(map: "pk_orders") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number             String                 @unique(map: "uq_orders_number") @db.VarChar(32)
  storeId            String                 @map("store_id") @db.Uuid
  store              Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_orders_store_id")
  websiteId          String                 @map("website_id") @db.Uuid
  website            Website                @relation(fields: [websiteId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_orders_website_id")
  customerId         String?                @map("customer_id") @db.Uuid
  customer           Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_orders_customer_id")
  cartId             String?                @map("cart_id") @db.Uuid
  idempotencyKey     String                 @map("idempotency_key") @db.VarChar(100)
  /// Guest access to the order (hashed); customers use their session.
  accessTokenHash    String                 @map("access_token_hash") @db.Char(64)
  email              String                 @db.Citext
  customerGroupCode  String                 @map("customer_group_code") @db.VarChar(64)
  localeCode         String                 @map("locale_code") @db.VarChar(16)
  currencyCode       String                 @map("currency_code") @db.Char(3)
  currency           Currency               @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_orders_currency_code")
  status             OrderStatus            @default(PENDING_PAYMENT)
  paymentStatus      OrderPaymentStatus     @default(UNPAID) @map("payment_status")
  fulfillmentStatus  OrderFulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  pricesIncludeTax   Boolean                @map("prices_include_tax")
  subtotal           BigInt
  discountTotal      BigInt                 @default(0) @map("discount_total")
  shippingTotal      BigInt                 @default(0) @map("shipping_total")
  taxTotal           BigInt                 @default(0) @map("tax_total")
  grandTotal         BigInt                 @map("grand_total")
  loyaltyPoints      Int                    @default(0) @map("loyalty_points")
  loyaltyAmount      BigInt                 @default(0) @map("loyalty_amount")
  /// Grand total minus what loyalty points paid.
  amountDue          BigInt                 @map("amount_due")
  amountPaid         BigInt                 @default(0) @map("amount_paid")
  amountRefunded     BigInt                 @default(0) @map("amount_refunded")
  couponCode         String?                @map("coupon_code") @db.VarChar(64)
  shippingMethodCode String?                @map("shipping_method_code") @db.VarChar(64)
  shippingMethodName String?                @map("shipping_method_name") @db.VarChar(255)
  /// `[{ promotionId, label, discount }]` and the tax breakdown by rate, as calculated at checkout.
  discounts          Json                   @default("[]")
  taxBreakdown       Json                   @default("[]") @map("tax_breakdown")
  placedAt           DateTime               @default(now()) @map("placed_at") @db.Timestamptz(3)
  paidAt             DateTime?              @map("paid_at") @db.Timestamptz(3)
  canceledAt         DateTime?              @map("canceled_at") @db.Timestamptz(3)
  version            Int                    @default(0)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  items              OrderItem[]
  addresses          OrderAddress[]
  history            OrderHistory[]
  payments           Payment[]
  refunds            Refund[]
  shipments          Shipment[]
  invoices           Invoice[]
  creditMemos        CreditMemo[]

  @@unique([storeId, idempotencyKey], map: "uq_orders_store_id_idempotency_key")
  @@unique([cartId], map: "uq_orders_cart_id")
  @@index([websiteId], map: "ix_orders_website_id")
  @@index([customerId, placedAt(sort: Desc)], map: "ix_orders_customer_id_placed_at")
  @@index([currencyCode], map: "ix_orders_currency_code")
  @@index([status, placedAt], map: "ix_orders_status_placed_at")
  @@index([email], map: "ix_orders_email")
  @@map("orders")
}

model OrderItem {
  id                 String          @id(map: "pk_order_items") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_order_items_order_id")
  /// Bundle components point at their bundle line.
  parentItemId       String?         @map("parent_item_id") @db.Uuid
  parent             OrderItem?      @relation("OrderItemChildren", fields: [parentItemId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_order_items_parent_item_id")
  children           OrderItem[]     @relation("OrderItemChildren")
  productId          String?         @map("product_id") @db.Uuid
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_order_items_product_id")
  variantId          String?         @map("variant_id") @db.Uuid
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_order_items_variant_id")
  sku                String          @db.VarChar(64)
  name               String          @db.VarChar(255)
  productType        ProductType     @map("product_type")
  quantity           Int
  unitPrice          BigInt          @map("unit_price")
  rowTotal           BigInt          @map("row_total")
  discount           BigInt          @default(0)
  taxAmount          BigInt          @default(0) @map("tax_amount")
  /// Effective tax rate of the line (percent).
  taxRate            Decimal         @default(0) @map("tax_rate") @db.Decimal(7, 4)
  options            Json            @default("[]")
  /// Inventory reservation (released on cancel, converted when paid).
  reservationGroupId String?         @map("reservation_group_id") @db.Uuid
  qtyShipped         Int             @default(0) @map("qty_shipped")
  qtyRefunded        Int             @default(0) @map("qty_refunded")
  shipmentItems      ShipmentItem[]

  @@index([orderId], map: "ix_order_items_order_id")
  @@index([parentItemId], map: "ix_order_items_parent_item_id")
  @@index([productId], map: "ix_order_items_product_id")
  @@index([variantId], map: "ix_order_items_variant_id")
  @@map("order_items")
}

enum AddressType {
  SHIPPING
  BILLING
}

model OrderAddress {
  id          String      @id(map: "pk_order_addresses") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_order_addresses_order_id")
  type        AddressType
  firstName   String      @map("first_name") @db.VarChar(100)
  lastName    String      @map("last_name") @db.VarChar(100)
  company     String?     @db.VarChar(255)
  phone       String?     @db.VarChar(32)
  countryCode String      @map("country_code") @db.Char(2)
  regionCode  String?     @map("region_code") @db.VarChar(16)
  city        String      @db.VarChar(100)
  postcode    String?     @db.VarChar(20)
  line1       String      @db.VarChar(255)
  line2       String?     @db.VarChar(255)

  @@unique([orderId, type], map: "uq_order_addresses_order_id_type")
  @@map("order_addresses")
}

/// The order timeline (status changes, payments, shipments, refunds, notes).
model OrderHistory {
  id         String   @id(map: "pk_order_history") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_order_history_order_id")
  event      String   @db.VarChar(64)
  message    String   @db.VarChar(1000)
  actorLabel String   @map("actor_label") @db.VarChar(255)
  /// Shown to the customer (else staff only).
  isPublic   Boolean  @default(false) @map("is_public")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, createdAt], map: "ix_order_history_order_id_created_at")
  @@map("order_history")
}

enum PaymentProviderCode {
  STRIPE
  PAYPAL
  VNPAY
  MOMO
  COD
}

enum PaymentMode {
  TEST
  LIVE
}

/// A configured provider account. Credentials are sealed (AES-GCM, APP_ENCRYPTION_KEY) and never returned.
model PaymentProvider {
  id          String                @id(map: "pk_payment_providers") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        PaymentProviderCode
  name        String                @db.VarChar(255)
  mode        PaymentMode           @default(TEST)
  credentials String?
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  methods     StorePaymentMethod[]
  payments    Payment[]
  webhooks    PaymentWebhookEvent[]

  @@map("payment_providers")
}

/// What a store offers at checkout: a provider, in order, within amount / country / currency limits.
model StorePaymentMethod {
  id            String                          @id(map: "pk_store_payment_methods") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String                          @map("store_id") @db.Uuid
  store         Store                           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_store_payment_methods_store_id")
  providerId    String                          @map("provider_id") @db.Uuid
  provider      PaymentProvider                 @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_store_payment_methods_provider_id")
  code          String                          @db.VarChar(64)
  position      Int                             @default(0)
  /// Order amount limits in minor units of the order currency (per currency).
  minAmounts    Json?                           @map("min_amounts")
  maxAmounts    Json?                           @map("max_amounts")
  countryCodes  String[]                        @default([]) @map("country_codes") @db.Char(2)
  currencyCodes String[]                        @default([]) @map("currency_codes") @db.Char(3)
  isActive      Boolean                         @default(true) @map("is_active")
  createdAt     DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)
  translations  StorePaymentMethodTranslation[]
  payments      Payment[]

  @@unique([storeId, code], map: "uq_store_payment_methods_store_id_code")
  @@index([providerId], map: "ix_store_payment_methods_provider_id")
  @@map("store_payment_methods")
}

model StorePaymentMethodTranslation {
  id          String             @id(map: "pk_store_payment_method_translations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  methodId    String             @map("method_id") @db.Uuid
  method      StorePaymentMethod @relation(fields: [methodId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_store_payment_method_translations_method_id")
  localeCode  String             @map("locale_code") @db.VarChar(16)
  locale      Locale             @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade, map: "fk_store_payment_method_translations_locale_code")
  title       String             @db.VarChar(255)
  description String?            @db.VarChar(500)

  @@unique([methodId, localeCode], map: "uq_store_payment_method_translations_method_id_locale_code")
  @@index([localeCode], map: "ix_store_payment_method_translations_locale_code")
  @@map("store_payment_method_translations")
}

enum PaymentStatus {
  /// Created; the shopper still has to act (redirect, card form, wallet).
  PENDING
  /// Cash on delivery: accepted, to be collected.
  AWAITING_COLLECTION
  CAPTURED
  FAILED
  CANCELED
}

/// One attempt to pay an order with one method.
model Payment {
  id             String               @id(map: "pk_payments") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String               @map("order_id") @db.Uuid
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_payments_order_id")
  methodId       String?              @map("method_id") @db.Uuid
  method         StorePaymentMethod?  @relation(fields: [methodId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_payments_method_id")
  providerId     String               @map("provider_id") @db.Uuid
  provider       PaymentProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_payments_provider_id")
  providerCode   PaymentProviderCode  @map("provider_code")
  status         PaymentStatus        @default(PENDING)
  amount         BigInt
  amountRefunded BigInt               @default(0) @map("amount_refunded")
  currencyCode   String               @map("currency_code") @db.Char(3)
  /// The provider's id of the intent / order / transaction.
  providerRef    String?              @map("provider_ref") @db.VarChar(128)
  /// The provider's id of the captured charge (refunds target it).
  captureRef     String?              @map("capture_ref") @db.VarChar(128)
  /// What the shopper must do next (redirect URL, client secret, QR) — no secrets.
  action         Json?
  failureReason  String?              @map("failure_reason") @db.VarChar(500)
  capturedAt     DateTime?            @map("captured_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  transactions   PaymentTransaction[]
  refunds        Refund[]

  @@unique([orderId], where: raw("status = ANY (ARRAY['PENDING'::\"PaymentStatus\", 'AWAITING_COLLECTION'::\"PaymentStatus\", 'CAPTURED'::\"PaymentStatus\"])"), map: "uq_payments_open_per_order")
  @@index([methodId], map: "ix_payments_method_id")
  @@index([providerId, providerRef], map: "ix_payments_provider_id_provider_ref")
  @@index([status, createdAt], map: "ix_payments_status_created_at")
  @@map("payments")
}

enum PaymentTransactionType {
  INITIATE
  CAPTURE
  VOID
  REFUND
  FAILURE
}

/// The full trail of a payment: every call and notification, with the (secret-free) provider response.
model PaymentTransaction {
  id          String                 @id(map: "pk_payment_transactions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String                 @map("payment_id") @db.Uuid
  payment     Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_transactions_payment_id")
  type        PaymentTransactionType
  amount      BigInt
  succeeded   Boolean
  providerRef String?                @map("provider_ref") @db.VarChar(128)
  /// webhook / return / api / reconciliation / admin
  source      String                 @db.VarChar(32)
  raw         Json?
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([paymentId, createdAt], map: "ix_payment_transactions_payment_id_created_at")
  @@map("payment_transactions")
}

enum WebhookStatus {
  PROCESSED
  IGNORED
  FAILED
}

/// Webhooks are processed once per provider event id.
model PaymentWebhookEvent {
  id              String          @id(map: "pk_payment_webhook_events") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId      String          @map("provider_id") @db.Uuid
  provider        PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_webhook_events_provider_id")
  providerEventId String          @map("provider_event_id") @db.VarChar(128)
  eventType       String          @map("event_type") @db.VarChar(128)
  payload         Json
  status          WebhookStatus
  error           String?         @db.VarChar(1000)
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([providerId, providerEventId], map: "uq_payment_webhook_events_provider_event")
  @@index([receivedAt], map: "ix_payment_webhook_events_received_at")
  @@map("payment_webhook_events")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id             String       @id(map: "pk_refunds") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_refunds_order_id")
  paymentId      String       @map("payment_id") @db.Uuid
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_refunds_payment_id")
  amount         BigInt
  currencyCode   String       @map("currency_code") @db.Char(3)
  status         RefundStatus @default(PENDING)
  reason         String?      @db.VarChar(500)
  /// `[{ orderItemId, quantity }]` returned with this refund.
  items          Json         @default("[]")
  restock        Boolean      @default(false)
  providerRef    String?      @map("provider_ref") @db.VarChar(128)
  failureReason  String?      @map("failure_reason") @db.VarChar(500)
  idempotencyKey String?      @map("idempotency_key") @db.VarChar(100)
  createdById    String?      @map("created_by_id") @db.Uuid
  createdBy      AdminUser?   @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_refunds_created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  creditMemo     CreditMemo?

  @@unique([orderId, idempotencyKey], map: "uq_refunds_order_id_idempotency_key")
  @@index([paymentId], map: "ix_refunds_payment_id")
  @@index([createdById], map: "ix_refunds_created_by_id")
  @@map("refunds")
}

enum ShipmentStatus {
  SHIPPED
  DELIVERED
}

model Shipment {
  id             String         @id(map: "pk_shipments") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_shipments_order_id")
  number         String         @unique(map: "uq_shipments_number") @db.VarChar(32)
  carrier        String         @db.VarChar(64)
  trackingNumber String?        @map("tracking_number") @db.VarChar(128)
  trackingUrl    String?        @map("tracking_url") @db.VarChar(512)
  status         ShipmentStatus @default(SHIPPED)
  shippedAt      DateTime       @default(now()) @map("shipped_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  items          ShipmentItem[]

  @@index([orderId], map: "ix_shipments_order_id")
  @@map("shipments")
}

model ShipmentItem {
  id          String    @id(map: "pk_shipment_items") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId  String    @map("shipment_id") @db.Uuid
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_shipment_items_shipment_id")
  orderItemId String    @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_shipment_items_order_item_id")
  quantity    Int

  @@unique([shipmentId, orderItemId], map: "uq_shipment_items_shipment_id_order_item_id")
  @@index([orderItemId], map: "ix_shipment_items_order_item_id")
  @@map("shipment_items")
}

/// Accounting document issued when an order is paid (Magento parity).
model Invoice {
  id            String   @id(map: "pk_invoices") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @unique(map: "uq_invoices_order_id") @map("order_id") @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_invoices_order_id")
  number        String   @unique(map: "uq_invoices_number") @db.VarChar(32)
  currencyCode  String   @map("currency_code") @db.Char(3)
  subtotal      BigInt
  discountTotal BigInt   @map("discount_total")
  shippingTotal BigInt   @map("shipping_total")
  taxTotal      BigInt   @map("tax_total")
  grandTotal    BigInt   @map("grand_total")
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  @@map("invoices")
}

/// Accounting document of a refund.
model CreditMemo {
  id           String   @id(map: "pk_credit_memos") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_credit_memos_order_id")
  refundId     String   @unique(map: "uq_credit_memos_refund_id") @map("refund_id") @db.Uuid
  refund       Refund   @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_credit_memos_refund_id")
  number       String   @unique(map: "uq_credit_memos_number") @db.VarChar(32)
  currencyCode String   @map("currency_code") @db.Char(3)
  amount       BigInt
  /// Tax share of the refund (proportional to the order).
  taxAmount    BigInt   @map("tax_amount")
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  @@index([orderId], map: "ix_credit_memos_order_id")
  @@map("credit_memos")
}

// ───────────────────────────── Phase 7 — jobs, imports/exports, outgoing webhooks ─────────────────────────────

/// Admin-defined job (PLAN.md §5): a registered type (`export.orders`, `search.reindex`, …) with its
/// parameters, run on a cron schedule and/or on demand.
model Job {
  id          String         @id(map: "pk_jobs") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String         @unique(map: "uq_jobs_code") @db.VarChar(64)
  name        String         @db.VarChar(255)
  type        String         @db.VarChar(64)
  params      Json           @default("{}")
  /// Five-field cron expression; null = run on demand only.
  cron        String?        @db.VarChar(100)
  timezone    String         @default("UTC") @db.VarChar(64)
  isActive    Boolean        @default(true) @map("is_active")
  lastRunAt   DateTime?      @map("last_run_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  createdBy   AdminUser?     @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_jobs_created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  executions  JobExecution[]

  @@index([createdById], map: "ix_jobs_created_by_id")
  @@map("jobs")
}

enum JobExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum JobTrigger {
  SCHEDULE
  MANUAL
}

/// One run of a job type: a defined job (scheduled or "run now") or a one-off import/export. At most
/// one open run per defined job (partial unique index).
model JobExecution {
  id              String             @id(map: "pk_job_executions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId           String?            @map("job_id") @db.Uuid
  job             Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_job_executions_job_id")
  type            String             @db.VarChar(64)
  status          JobExecutionStatus @default(QUEUED)
  trigger         JobTrigger
  params          Json               @default("{}")
  /// 0–100.
  progress        Int                @default(0)
  /// Counters reported by the handler (`rows`, `created`, `updated`, `failed`, …).
  stats           Json               @default("{}")
  /// First row-level problems: `[{ row, message }]` (at most 100).
  errors          Json               @default("[]")
  error           String?            @db.VarChar(2000)
  /// Uploaded input (imports) and produced file (exports), object keys in storage.
  inputKey        String?            @map("input_key") @db.VarChar(512)
  outputKey       String?            @map("output_key") @db.VarChar(512)
  outputName      String?            @map("output_name") @db.VarChar(255)
  cancelRequested Boolean            @default(false) @map("cancel_requested")
  /// Who started it (`admin`, `api-key`, `system` for schedules), as in the audit log.
  actorType       String             @map("actor_type") @db.VarChar(16)
  actorId         String?            @map("actor_id") @db.Uuid
  actorLabel      String             @map("actor_label") @db.VarChar(255)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?          @map("finished_at") @db.Timestamptz(3)

  @@unique([jobId], where: raw("status = ANY (ARRAY['QUEUED'::\"JobExecutionStatus\", 'RUNNING'::\"JobExecutionStatus\"])"), map: "uq_job_executions_open_per_job")
  @@index([jobId, createdAt(sort: Desc)], map: "ix_job_executions_job_id_created_at")
  @@index([status, createdAt], map: "ix_job_executions_status_created_at")
  @@index([createdAt], map: "ix_job_executions_created_at")
  @@map("job_executions")
}

/// Outgoing webhook subscription: committed domain events POSTed (signed) to an integration.
model Webhook {
  id                  String            @id(map: "pk_webhooks") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String            @db.VarChar(255)
  url                 String            @db.VarChar(2048)
  /// Event names or `prefix.*` patterns from the published catalogue.
  events              String[]          @default([]) @db.VarChar(100)
  /// Signing secret, sealed (SecretsService).
  secret              String
  isActive            Boolean           @default(true) @map("is_active")
  consecutiveFailures Int               @default(0) @map("consecutive_failures")
  disabledReason      String?           @map("disabled_reason") @db.VarChar(500)
  createdById         String?           @map("created_by_id") @db.Uuid
  createdBy           AdminUser?        @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_webhooks_created_by_id")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries          WebhookDelivery[]

  @@index([createdById], map: "ix_webhooks_created_by_id")
  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One event for one webhook: once per (webhook, event), retried with backoff until it succeeds or
/// gives up.
model WebhookDelivery {
  id             String                @id(map: "pk_webhook_deliveries") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhookId      String                @map("webhook_id") @db.Uuid
  webhook        Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_webhook_deliveries_webhook_id")
  eventId        String                @map("event_id") @db.Uuid
  eventName      String                @map("event_name") @db.VarChar(120)
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body") @db.VarChar(1000)
  error          String?               @db.VarChar(1000)
  durationMs     Int?                  @map("duration_ms")
  nextAttemptAt  DateTime?             @map("next_attempt_at") @db.Timestamptz(3)
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([webhookId, eventId], map: "uq_webhook_deliveries_webhook_id_event_id")
  @@index([webhookId, createdAt(sort: Desc)], map: "ix_webhook_deliveries_webhook_id_created_at")
  @@index([status, nextAttemptAt], map: "ix_webhook_deliveries_status_next_attempt_at")
  @@index([createdAt], map: "ix_webhook_deliveries_created_at")
  @@map("webhook_deliveries")
}
