# Copy to .env and fill in every "change-me". Never commit .env.
# Generate secrets with:  openssl rand -hex 32

NODE_ENV=development
PORT=3300
# Comma-separated browser origins (storefront theme, admin console). Empty = same-origin only.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# LOG_FORMAT=pretty

# ─── docker compose (also used by the app below) ───
POSTGRES_PASSWORD=change-me
# Connections per process and the wait for a free one (API replicas × pool + workers × pool ≤ max_connections).
# DATABASE_POOL_MAX=20
# DATABASE_POOL_TIMEOUT_MS=10000
DATABASE_URL=postgresql://shop:change-me@localhost:5434/shop?schema=public

# Redis always requires a password (≥16 chars in production).
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=change-me-to-a-long-random-value

# ─── Admin authentication ───
# ≥32 chars. Rotating it signs every admin out.
AUTH_JWT_SECRET=change-me-to-64-hex-chars
# AUTH_ACCESS_TTL_S=900
# AUTH_REFRESH_TTL_DAYS=30
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCKOUT_MINUTES=15

# ─── Object storage (MinIO locally, S3 in production) ───
S3_ENDPOINT=http://localhost:9200
# Endpoint browsers reach for signed links, when S3_ENDPOINT is internal (e.g. http://minio:9000 in containers).
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=shop-media
S3_ACCESS_KEY_ID=shop
S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
S3_FORCE_PATH_STYLE=true

# ─── Media ───
# Public origin (CDN) in front of the media bucket. Empty → the storefront gets signed URLs.
# MEDIA_PUBLIC_BASE_URL=https://cdn.shop.example
# MEDIA_MAX_UPLOAD_MB=20

# ─── Secrets at rest (search engine and, later, payment credentials) ───
# 32 bytes as 64 hex chars:  openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Public origin of this API — payment providers (Stripe, PayPal, VNPay, MoMo) call
# /api/v1/webhooks/payments/:providerId on it. https is required in production.
# API_PUBLIC_URL=https://api.shop.example

# ─── Search ───
# Postgres full text is the default. For Meilisearch:  docker compose --profile search up -d
# then PUT /api/v1/admin/search/websites/:id { "provider": "MEILISEARCH", "connection": { "url": "http://localhost:7701", "apiKey": "<MEILI_MASTER_KEY>" } }
MEILI_MASTER_KEY=change-me-at-least-16-chars
# SEARCH_DROP_DELAY_MS=60000

# ─── Rate limits (per principal, or per IP when anonymous) ───
# THROTTLE_LIMIT=300
# THROTTLE_AUTH_LIMIT=10

SWAGGER_ENABLED=true
# Worker: comma-separated queues this process runs (empty = all).
# WORKER_QUEUES=

# ─── Jobs, imports and exports ───
# JOBS_CONCURRENCY=2
# JOBS_FILE_RETENTION_DAYS=7     # export/import files
# JOBS_HISTORY_DAYS=90           # execution history
# IMPORT_MAX_MB=50

# ─── Audit log and outgoing webhooks ───
# AUDIT_RETENTION_DAYS=365       # 0 = keep forever
# WEBHOOK_TIMEOUT_MS=10000
# WEBHOOK_MAX_ATTEMPTS=10          # retries back off from 1 min, doubling (≈ 8.5 h in all)
# WEBHOOK_DISABLE_AFTER=20       # consecutive failed deliveries before a webhook is switched off
# WEBHOOK_DELIVERY_RETENTION_DAYS=30
# Local development only: allow webhooks to localhost / private networks.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Anonymous storefront GETs served from Redis for up to this many seconds (purged on changes; 0 = off).
# STOREFRONT_CACHE_TTL_S=30

# ─── Metrics (Prometheus) ───
# Bearer token for GET /metrics (required in production):  openssl rand -hex 24
METRICS_TOKEN=
# The worker serves /metrics on this port (0 = off).
# WORKER_METRICS_PORT=9464

# Demo catalog (two websites, every product type):  npm run build && npm run seed:demo
# First super-admin:  ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='…' npm run admin:create
